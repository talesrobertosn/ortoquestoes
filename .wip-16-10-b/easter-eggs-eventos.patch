+/**
+ * Ligar e desligar as surpresas (eventos aleatórios), em Minha conta > Preferências.
+ *
+ * Fica guardado neste aparelho ('eventos:desligados', preferência do aparelho, como o tema) e,
+ * com conta, também no perfil (user_metadata.surpresas_desligadas), que já viaja entre aparelhos
+ * sem SQL novo. A escolha feita neste aparelho vale; num aparelho novo (nada guardado ainda),
+ * vale a do perfil.
+ */
+import { useCallback } from 'react'
+import { usarConta } from '../conta/ContextoConta'
+import { supabase } from '../conta/supabase'
+import { usarArmazenado } from '../estado/usarArmazenado'
+
+export const CHAVE_SURPRESAS_DESLIGADAS = 'eventos:desligados'
+export const CAMPO_PERFIL = 'surpresas_desligadas'
+
+export function surpresasDesligadas(local: boolean | null, meta?: Record<string, unknown> | null): boolean {
+  if (typeof local === 'boolean') return local
+  return meta?.[CAMPO_PERFIL] === true
+}
+
+export function usarSurpresasDesligadas() {
+  const { sessao } = usarConta()
+  const [local, definirLocal] = usarArmazenado<boolean | null>(CHAVE_SURPRESAS_DESLIGADAS, null)
+  const desligado = surpresasDesligadas(local, sessao?.user.user_metadata)
+  const definir = useCallback((valor: boolean) => {
+    definirLocal(valor)
+    if (sessao && supabase) void supabase.auth.updateUser({ data: { [CAMPO_PERFIL]: valor } }).catch(() => undefined)
+  }, [definirLocal, sessao])
+  return [desligado, definir] as const
+}
