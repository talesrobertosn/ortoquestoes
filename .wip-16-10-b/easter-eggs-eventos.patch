@@ -0,0 +1,46 @@
+/**
+ * Gato da Biblioteca (easter egg): dorme num canto da Biblioteca de Flashcards. Um toque o acorda;
+ * três toques e ele fica feliz, com coração, e ronrona um recado. Volta a dormir sozinho.
+ * Arte já existente do jogo (public/flashcards/vfx/gato-*.png, 6 quadros de 40x30).
+ */
+import { useEffect, useRef, useState, type CSSProperties } from 'react'
+import { urlCss } from '../config'
+import { FRASES_GATO } from './frases'
+import { marcarAchado } from './memoria'
+import { GATO_TOQUES } from './regras'
+
+type Humor = 'dorme' | 'acorda' | 'feliz'
+
+export function GatoBiblioteca({ aoMiar }: { aoMiar: (frase: string) => void }) {
+  const [humor, definirHumor] = useState<Humor>('dorme')
+  const toques = useRef(0)
+  const vez = useRef(0)
+  const volta = useRef(0)
+  useEffect(() => () => window.clearTimeout(volta.current), [])
+
+  function tocar() {
+    toques.current += 1
+    window.clearTimeout(volta.current)
+    if (toques.current >= GATO_TOQUES) {
+      toques.current = 0
+      definirHumor('feliz')
+      marcarAchado('gato')
+      aoMiar(FRASES_GATO[vez.current++ % FRASES_GATO.length])
+      volta.current = window.setTimeout(() => definirHumor('dorme'), 6000)
+    } else {
+      definirHumor('acorda')
+      volta.current = window.setTimeout(() => { toques.current = 0; definirHumor('dorme') }, 4000)
+    }
+  }
+
+  return (
+    <button
+      type="button"
+      className={`oq-gato oq-gato--${humor}`}
+      style={{ '--gato': urlCss(`flashcards/vfx/gato-${humor}.png`) } as CSSProperties}
+      onClick={tocar}
+      aria-label="Gato da Biblioteca"
+      title="Zzz"
+    />
+  )
+}
diff --git a/src/eventos/Surpresas.tsx b/src/eventos/Surpresas.tsx
new file mode 100644
index 0000000..acf8848
--- /dev/null
+++ b/src/eventos/Surpresas.tsx
@@ -0,0 +1,286 @@
+/**
+ * Surpresas do site: eventos aleatórios e easter eggs (docs/EASTER-EGGS-E-EVENTOS.md).
+ *
+ * Carregado sob demanda pelo App, alguns segundos depois da primeira tela, para não pesar no
+ * código inicial. As regras (quando pode, qual aparece) moram em ./regras, testadas em
+ * fixtures/testar_eventos.mjs; aqui ficam só o relógio, os ouvintes e o desenho.
+ */
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { recurso } from '../config'
+import { usarConta } from '../conta/ContextoConta'
+import { EVENTO_DADOS, ler, type MudancaDados } from '../estado/armazenamento'
+import { DATAS_PROVA } from '../estado/conquistas'
+import type { EstadoSessao } from '../dados/tipos'
+import { href } from '../util/rotas'
+import { FRASE_KONAMI, FRASES_MARTELO, FRASES_TINEL, RECADO_CONSOLE } from './frases'
+import { atualizarMemoria, lerMemoria, marcarAchado } from './memoria'
+import { usarSurpresasDesligadas } from './preferencia'
+import {
+  avancarKonami, contarToques, eggPermitido, ehPlantao, escolherEvento, estatisticasDeRespostas, eventoForcado,
+  marcoCruzado, MARTELO_JANELA, MARTELO_TOQUES, MINUTO, registrarExibicao, TINEL_JANELA, TINEL_TOQUES, totalRespostas,
+  type Contexto, type Evento, type Personagem, type SessaoResumo,
+} from './regras'
+import { GatoBiblioteca } from './GatoBiblioteca'
+import './surpresas.css'
+
+/** Espera depois de abrir o site antes da primeira verificação (ninguém quer surpresa na porta). */
+const ESPERA_INICIAL = 45_000
+const VERIFICAR_A_CADA = MINUTO
+
+interface Props { segmentos: string[]; consulta: URLSearchParams; jogo: boolean }
+
+interface Exibicao { evento: Evento; chave: number; link?: { texto: string; destino: string } }
+
+function resumoSessao(): SessaoResumo | null {
+  const s = ler<EstadoSessao | null>('sessao:atual', null)
+  if (!s || !Array.isArray(s.ids)) return null
+  const atual = s.ids[s.posicao ?? 0]
+  return {
+    concluida: !!s.concluidaEm,
+    criadaEm: s.criadaEm ?? 0,
+    simulado: s.simulado,
+    limiteSegundos: s.limiteSegundos,
+    nacional: s.nacional,
+    questaoAtualAberta: !!atual && !s.respostas?.[atual],
+  }
+}
+
+const movimentoReduzido = () => typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches
+
+export function Surpresas({ segmentos, consulta, jogo }: Props) {
+  const { sessao } = usarConta()
+  const [desligado] = usarSurpresasDesligadas()
+  const [exibicao, definirExibicao] = useState<Exibicao | null>(null)
+  const [danca, definirDanca] = useState(false)
+  const rota = useRef({ segmentos, jogo })
+  rota.current = { segmentos, jogo }
+  const desligadoRef = useRef(desligado)
+  desligadoRef.current = desligado
+  const meta = sessao?.user.user_metadata as Record<string, unknown> | undefined
+  const perfil = useRef({ nascimento: '', criada: '', nome: '' })
+  perfil.current = { nascimento: String(meta?.nascimento ?? ''), criada: sessao?.user.created_at ?? '', nome: String(meta?.nome ?? '') }
+
+  const contexto = useCallback((agora = new Date()): Contexto => {
+    const respondidas = ler<Record<string, never>>('respondidas', {})
+    return {
+      agora,
+      segmentos: rota.current.segmentos,
+      jogo: rota.current.jogo,
+      sessao: resumoSessao(),
+      desligado: desligadoRef.current,
+      movimentoReduzido: movimentoReduzido(),
+      memoria: lerMemoria(),
+      nascimento: perfil.current.nascimento,
+      contaCriadaEm: perfil.current.criada,
+      nome: perfil.current.nome,
+      dataProva: DATAS_PROVA[DATAS_PROVA.length - 1],
+      ...estatisticasDeRespostas(respondidas, agora),
+    }
+  }, [])
+
+  const mostrar = useCallback((evento: Evento, link?: Exibicao['link']) => {
+    definirExibicao({ evento, chave: Date.now(), link })
+  }, [])
+
+  const verificar = useCallback(() => {
+    if (document.visibilityState === 'hidden') return
+    const ctx = contexto()
+    const evento = escolherEvento(ctx)
+    if (!evento) return
+    atualizarMemoria((m) => registrarExibicao(m, evento, ctx.agora))
+    mostrar(evento)
+  }, [contexto, mostrar])
+
+  // Relógio: primeira olhada depois da espera; depois, uma por minuto e a cada troca de página.
+  const [pronto, definirPronto] = useState(false)
+  useEffect(() => {
+    const t = window.setTimeout(() => definirPronto(true), ESPERA_INICIAL)
+    return () => window.clearTimeout(t)
+  }, [])
+  useEffect(() => {
+    if (!pronto) return
+    const t = window.setInterval(verificar, VERIFICAR_A_CADA)
+    return () => window.clearInterval(t)
+  }, [pronto, verificar])
+  const textoRota = segmentos.join('/')
+  useEffect(() => {
+    if (!pronto) return
+    const t = window.setTimeout(verificar, 2500)
+    return () => window.clearTimeout(t)
+  }, [pronto, textoRota, verificar])
+
+  // ?surpresa=<id>: mostra aquela surpresa já (para testar e capturar); respeita os bloqueios.
+  const forcada = consulta.get('surpresa')
+  useEffect(() => {
+    if (!forcada) return
+    const t = window.setTimeout(() => {
+      if (forcada === 'agora') { verificar(); return }
+      const ctx = contexto()
+      const evento = eventoForcado(forcada, ctx)
+      if (evento) mostrar(evento)
+    }, 600)
+    return () => window.clearTimeout(t)
+  }, [forcada, contexto, mostrar, verificar])
+
+  // Festa das 1.000, 5.000 e 10.000 respostas: só as respostas dadas aqui (não a sincronia).
+  useEffect(() => {
+    const aoMudar = (e: Event) => {
+      const d = (e as CustomEvent<MudancaDados>).detail
+      if (d.chave !== 'respondidas' || d.origem !== 'local') return
+      const marco = marcoCruzado(totalRespostas(d.antes as Record<string, never>), totalRespostas(d.valor as Record<string, never>))
+      if (!marco) return
+      atualizarMemoria((m) => m.marcos.includes(marco) ? m : { ...m, marcoPendente: marco })
+      // Logo depois da resposta (a questão já foi respondida); em simulado, espera acabar.
+      window.setTimeout(verificar, 1800)
+    }
+    window.addEventListener(EVENTO_DADOS, aoMudar)
+    return () => window.removeEventListener(EVENTO_DADOS, aoMudar)
+  }, [verificar])
+
+  // Plantão da madrugada: a logo ganha uma luazinha das 0h às 5h.
+  useEffect(() => {
+    const aplicar = () => document.body.classList.toggle('oq-plantao', ehPlantao(new Date()) && !desligadoRef.current)
+    aplicar()
+    const t = window.setInterval(aplicar, MINUTO)
+    return () => { window.clearInterval(t); document.body.classList.remove('oq-plantao') }
+  }, [desligado])
+
+  // Recado no console, uma vez por aba.
+  useEffect(() => {
+    try {
+      if (sessionStorage.getItem('oq-recado-console')) return
+      sessionStorage.setItem('oq-recado-console', '1')
+    } catch { /* sem armazenamento: recado mesmo assim */ }
+    const [oi, ...resto] = RECADO_CONSOLE
+    console.log(`%c${oi}`, 'font: 700 15px system-ui; color: #0f766e')
+    for (const linha of resto) console.log(`%c${linha}`, 'font: 13px system-ui; color: #64748b')
+  }, [])
+
+  const podeEgg = () => eggPermitido({ agora: new Date(), segmentos: rota.current.segmentos, sessao: resumoSessao() })
+
+  // Código Konami ortopédico.
+  useEffect(() => {
+    let posicao = 0
+    const aoTeclar = (e: KeyboardEvent) => {
+      const alvo = e.target as HTMLElement | null
+      if (alvo && (alvo.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(alvo.tagName))) { posicao = 0; return }
+      const [nova, completou] = avancarKonami(posicao, e.key)
+      posicao = nova
+      if (!completou || !podeEgg()) return
+      marcarAchado('konami')
+      if (!movimentoReduzido()) { definirDanca(true); window.setTimeout(() => definirDanca(false), 5200) }
+      mostrar({ id: 'mascote', personagem: 'esqueleto', titulo: 'Código ortopédico', frase: FRASE_KONAMI, duracaoMs: 9000 }, { texto: 'Abrir o Arquivo do Preceptor', destino: '/arquivo-do-preceptor' })
+    }
+    window.addEventListener('keydown', aoTeclar)
+    return () => window.removeEventListener('keydown', aoTeclar)
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [mostrar])
+
+  // Sinal de Tinel na logo e martelo de reflexo nos flashcards de classificação.
+  useEffect(() => {
+    let tinel: number[] = []
+    let martelo: number[] = []
+    let vez = 0
+    const aoTocar = (e: MouseEvent) => {
+      const alvo = e.target as HTMLElement | null
+      const logo = alvo?.closest<HTMLElement>('.cabecalho__marca')
+      if (logo) {
+        const [lista, bateu] = contarToques(tinel, Date.now(), TINEL_TOQUES, TINEL_JANELA)
+        tinel = lista
+        if (!bateu || !podeEgg()) return
+        marcarAchado('tinel')
+        logo.classList.remove('oq-tinel'); void logo.offsetWidth; logo.classList.add('oq-tinel')
+        window.setTimeout(() => logo.classList.remove('oq-tinel'), 1700)
+        mostrar({ id: 'mascote', personagem: 'mao', titulo: 'Sinal de Tinel', frase: FRASES_TINEL[vez++ % FRASES_TINEL.length], duracaoMs: 5000 })
+        return
+      }
+      const rotulo = alvo?.closest<HTMLElement>('.fc-carta__titulo small')
+      if (rotulo && /Classificação\s*$/.test(rotulo.textContent ?? '')) {
+        const [lista, bateu] = contarToques(martelo, Date.now(), MARTELO_TOQUES, MARTELO_JANELA)
+        martelo = lista
+        if (!bateu) return
+        marcarAchado('martelo')
+        const carta = rotulo.closest<HTMLElement>('.fc-carta')
+        if (carta && !movimentoReduzido()) {
+          carta.classList.remove('oq-reflexo'); void carta.offsetWidth; carta.classList.add('oq-reflexo')
+          window.setTimeout(() => carta.classList.remove('oq-reflexo'), 900)
+        }
+        mostrar({ id: 'mascote', personagem: 'martelo', titulo: 'Martelo de reflexo', frase: FRASES_MARTELO[vez++ % FRASES_MARTELO.length], duracaoMs: 5000 })
+      }
+    }
+    document.addEventListener('click', aoTocar, true)
+    return () => document.removeEventListener('click', aoTocar, true)
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [mostrar])
+
+  const biblioteca = segmentos[0] === 'flashcards' && (segmentos[1] === 'biblioteca' || segmentos[1] === 'estudo')
+
+  return (
+    <>
+      {exibicao && <Recado key={exibicao.chave} exibicao={exibicao} aoFechar={() => definirExibicao(null)} />}
+      {danca && <div className="oq-danca" aria-hidden="true"><img src={recurso('pixel/surpresas/esqueleto.png')} width={20} height={20} alt="" /></div>}
+      {biblioteca && <GatoBiblioteca aoMiar={(frase) => mostrar({ id: 'mascote', personagem: 'gato', titulo: 'Gato da Biblioteca', frase, duracaoMs: 4500 })} />}
+    </>
+  )
+}
+
+function srcPersonagem(p: Personagem): string {
+  if (p === 'mascote') return recurso('mascote/heroi-6.png')
+  if (p === 'gato') return recurso('flashcards/vfx/gato-feliz.png')
+  return recurso(`pixel/surpresas/${p}.png`)
+}
+
+function Recado({ exibicao, aoFechar }: { exibicao: Exibicao; aoFechar: () => void }) {
+  const { evento, link } = exibicao
+  const [saindo, definirSaindo] = useState(false)
+  const pausado = useRef(false)
+  const controle = useRef<{ pausar: () => void; seguir: () => void } | null>(null)
+  useEffect(() => {
+    let restante = evento.duracaoMs
+    let inicio = Date.now()
+    let t = 0
+    const agendar = () => { t = window.setTimeout(() => { if (pausado.current) return; definirSaindo(true); window.setTimeout(aoFechar, 350) }, restante) }
+    agendar()
+    const pausar = () => { pausado.current = true; window.clearTimeout(t); restante -= Date.now() - inicio }
+    const seguir = () => { pausado.current = false; inicio = Date.now(); restante = Math.max(1500, restante); agendar() }
+    controle.current = { pausar, seguir }
+    return () => window.clearTimeout(t)
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [])
+  const reduzido = movimentoReduzido()
+  return (
+    <>
+      {evento.efeito === 'confete' && !reduzido && <Confete />}
+      {evento.efeito === 'estrela' && !reduzido && <div className="oq-estrela-cadente" aria-hidden="true" />}
+      <aside
+        className={`oq-recado oq-recado--${evento.id}${saindo ? ' oq-recado--saindo' : ''}`}
+        role="status"
+        aria-live="polite"
+        data-surpresa={evento.id}
+        onMouseEnter={() => controle.current?.pausar()}
+        onMouseLeave={() => controle.current?.seguir()}
+      >
+        <span className={`oq-recado__arte oq-recado__arte--${evento.personagem}`} aria-hidden="true">
+          <img src={srcPersonagem(evento.personagem)} alt="" draggable={false} />
+        </span>
+        <span className="oq-recado__texto">
+          {evento.titulo && <strong>{evento.titulo}</strong>}
+          <span>{evento.frase}</span>
+          {link && <a href={href(link.destino)} onClick={aoFechar}>{link.texto}</a>}
+        </span>
+        <button type="button" className="oq-recado__fechar" onClick={aoFechar} aria-label="Fechar recado">×</button>
+      </aside>
+    </>
+  )
+}
+
+const CORES = ['#e0565b', '#ffd448', '#4a96c8', '#5ab06a', '#b06ad8', '#ff9a2a']
+function Confete() {
+  return (
+    <div className="oq-confete" aria-hidden="true">
+      {Array.from({ length: 28 }, (_, i) => (
+        <i key={i} style={{ left: `${(i * 37) % 100}%`, background: CORES[i % CORES.length], animationDelay: `${(i % 7) * 0.09}s`, animationDuration: `${1.8 + (i % 5) * 0.25}s` }} />
+      ))}
+    </div>
+  )
+}
