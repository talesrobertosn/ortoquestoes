+/**
+ * Memória das surpresas (o que já apareceu, quando, achados e selos), guardada na conta deste
+ * aparelho. Não sobe para o servidor e não entra em ranking nem em contagem nenhuma.
+ */
+import { gravar, ler } from '../estado/armazenamento'
+import { normalizarMemoria, registrarAchado, type Memoria } from './regras'
+
+export const CHAVE_MEMORIA = 'eventos:memoria'
+
+export const lerMemoria = (): Memoria => normalizarMemoria(ler<unknown>(CHAVE_MEMORIA, null))
+
+/** Lê, aplica a mudança e grava (sempre a partir do que está guardado agora). */
+export function atualizarMemoria(mudar: (m: Memoria) => Memoria): Memoria {
+  const nova = mudar(lerMemoria())
+  gravar(CHAVE_MEMORIA, nova)
+  return nova
+}
+
+export const marcarAchado = (id: string) => atualizarMemoria((m) => registrarAchado(m, id))
