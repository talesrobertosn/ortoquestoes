+/* Surpresas do site (eventos aleatórios e easter eggs). Carregado junto com o módulo, sob demanda. */
+
+/* ---------- Recado ---------- */
+.oq-recado {
+  position: fixed; z-index: 1050; left: 1rem; bottom: 1rem;
+  display: grid; grid-template-columns: auto 1fr auto; gap: 0.75rem; align-items: center;
+  width: min(24rem, calc(100vw - 2rem)); box-sizing: border-box;
+  padding: 0.7rem 0.6rem 0.7rem 0.75rem; border-radius: 14px;
+  color: var(--texto, #1d2433); background: var(--superficie, #fff);
+  border: 2px solid rgba(244, 207, 124, 0.7);
+  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.22), inset 0 0 0 1px rgba(255, 255, 255, 0.4);
+  animation: oq-recado-entra 0.42s cubic-bezier(0.2, 0.9, 0.3, 1.25) both;
+}
+.oq-recado--saindo { animation: oq-recado-sai 0.35s ease-in both; }
+.oq-recado__arte {
+  display: grid; place-items: center; width: 3.6rem; height: 3.6rem; border-radius: 12px;
+  background: radial-gradient(circle at 50% 40%, rgba(244, 207, 124, 0.35), rgba(244, 207, 124, 0.08) 70%);
+}
+.oq-recado__arte img { width: 3rem; height: 3rem; image-rendering: pixelated; animation: oq-pulinho 1.6s ease-in-out infinite; }
+.oq-recado__arte--mascote img { width: auto; height: 3.3rem; image-rendering: auto; }
+/* O gato é uma tira de 6 quadros: mostra só o primeiro. */
+.oq-recado__arte--gato { overflow: hidden; }
+.oq-recado__arte--gato img { width: auto; height: 2.6rem; object-fit: cover; object-position: 0 0; max-width: none; aspect-ratio: 40 / 30; }
+.oq-recado__texto { display: grid; gap: 0.15rem; font-size: 0.92rem; line-height: 1.35; min-width: 0; }
+.oq-recado__texto strong { font-family: var(--fonte-pixel); font-size: 0.98rem; letter-spacing: 0.01em; color: var(--ouro-texto, #8a5a0c); }
+.oq-recado__texto a { font-weight: 700; font-size: 0.88rem; margin-top: 0.15rem; }
+.oq-recado__fechar {
+  align-self: start; width: 1.9rem; height: 1.9rem; border: 0; border-radius: 50%; cursor: pointer;
+  font-size: 1.25rem; line-height: 1; color: var(--texto-2, #5b6475); background: transparent;
+}
+.oq-recado__fechar:hover, .oq-recado__fechar:focus-visible { background: rgba(127, 127, 127, 0.15); }
+[data-tema="escuro"] .oq-recado { border-color: rgba(244, 207, 124, 0.45); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); }
+/* No celular, acima da barra de navegação de baixo. */
+@media (max-width: 40rem) {
+  .oq-recado { left: 0.75rem; right: 0.75rem; width: auto; bottom: calc(4.6rem + env(safe-area-inset-bottom)); }
+}
+
+@keyframes oq-recado-entra { from { opacity: 0; transform: translateY(18px) scale(0.96); } to { opacity: 1; transform: none; } }
+@keyframes oq-recado-sai { to { opacity: 0; transform: translateY(12px); } }
+@keyframes oq-pulinho { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
+
+/* ---------- Confete ---------- */
+.oq-confete { position: fixed; inset: 0; z-index: 1049; pointer-events: none; overflow: hidden; }
+.oq-confete i { position: absolute; top: -12px; width: 8px; height: 12px; border-radius: 1px; opacity: 0.95; animation: oq-cai 2s cubic-bezier(0.3, 0.6, 0.5, 1) forwards; }
+.oq-confete i:nth-child(3n) { width: 6px; height: 6px; border-radius: 50%; }
+@keyframes oq-cai { to { transform: translateY(105vh) rotate(540deg); opacity: 0.9; } }
+
+/* ---------- Estrela cadente ---------- */
+.oq-estrela-cadente {
+  position: fixed; z-index: 1049; top: 8vh; right: 10vw; width: 140px; height: 3px; pointer-events: none;
+  border-radius: 2px; background: linear-gradient(90deg, rgba(255, 244, 192, 0), #fff4c0 70%, #fff);
+  box-shadow: 0 0 10px #ffd448; transform: rotate(-24deg); opacity: 0;
+  animation: oq-cadente 1.6s ease-out 0.2s forwards;
+}
+@keyframes oq-cadente {
+  0% { opacity: 0; transform: translate(0, 0) rotate(-24deg); }
+  15% { opacity: 1; }
+  100% { opacity: 0; transform: translate(-45vw, 22vh) rotate(-24deg); }
+}
+
+/* ---------- Esqueleto dançando (código ortopédico) ---------- */
+.oq-danca { position: fixed; z-index: 1049; left: 0; right: 0; bottom: 6.5rem; height: 5rem; pointer-events: none; }
+.oq-danca img { position: absolute; left: -5rem; width: 4.5rem; height: 4.5rem; image-rendering: pixelated; animation: oq-atravessa 5s linear forwards, oq-requebra 0.4s ease-in-out infinite alternate; }
+@keyframes oq-atravessa { to { left: calc(100% + 1rem); } }
+@keyframes oq-requebra { from { transform: rotate(-10deg) translateY(0); } to { transform: rotate(10deg) translateY(-8px); } }
+
+/* ---------- Sinal de Tinel na logo ---------- */
+.cabecalho__marca.oq-tinel { position: relative; }
+.cabecalho__marca.oq-tinel .cabecalho__selo { animation: oq-formiga 0.08s linear 18; }
+.cabecalho__marca.oq-tinel::after {
+  content: "⚡ ⚡ ⚡"; position: absolute; left: 100%; top: 50%; margin-left: 0.25rem; font-size: 0.75rem;
+  color: #f5b400; white-space: nowrap; transform: translateY(-50%); animation: oq-faisca 1.6s ease-out forwards; pointer-events: none;
+}
+@keyframes oq-formiga { 0% { transform: translate(0, 0); } 25% { transform: translate(1px, -1px); } 50% { transform: translate(-1px, 1px); } 75% { transform: translate(1px, 1px); } 100% { transform: translate(0, 0); } }
+@keyframes oq-faisca { 0% { opacity: 0; letter-spacing: -0.3em; } 20% { opacity: 1; } 100% { opacity: 0; letter-spacing: 0.6em; } }
+
+/* ---------- Plantão da madrugada: luazinha na logo ---------- */
+body.oq-plantao .cabecalho__selo { position: relative; }
+body.oq-plantao .cabecalho__selo::after {
+  content: ""; position: absolute; right: -0.55rem; top: -0.35rem; width: 0.7rem; height: 0.7rem; border-radius: 50%;
+  box-shadow: -3px 2px 0 0 #f4cf7c; transform: rotate(-20deg); pointer-events: none;
+}
+
+/* ---------- Martelo de reflexo no flashcard de classificação ---------- */
+.fc-carta.oq-reflexo { animation: oq-reflexo 0.8s cubic-bezier(0.3, 1.6, 0.5, 1); }
+@keyframes oq-reflexo { 0% { transform: none; } 18% { transform: translateY(2px) rotate(-1deg); } 40% { transform: translateY(-14px) rotate(2.5deg); } 70% { transform: translateY(2px) rotate(-0.5deg); } 100% { transform: none; } }
+
+/* ---------- Gato da Biblioteca ---------- */
+.oq-gato {
+  position: fixed; z-index: 1040; left: 0.6rem; bottom: 0.4rem; width: 60px; height: 45px; padding: 0; border: 0; cursor: pointer;
+  background: var(--gato) 0 0 / 360px 45px no-repeat; image-rendering: pixelated;
+  animation: oq-gato-quadros 1.5s steps(6) infinite; opacity: 0.92;
+}
+.oq-gato--acorda { animation-duration: 0.95s; }
+.oq-gato--feliz { animation-duration: 0.72s; }
+.oq-gato:focus-visible { outline: 2px solid #f4cf7c; outline-offset: 2px; border-radius: 6px; }
+@keyframes oq-gato-quadros { to { background-position: -360px 0; } }
+@media (max-width: 40rem) { .oq-gato { bottom: calc(0.3rem + env(safe-area-inset-bottom)); width: 48px; height: 36px; background-size: 288px 36px; } @keyframes oq-gato-quadros { to { background-position: -288px 0; } } }
+
+/* ---------- Movimento reduzido: tudo parado, só aparece e some ---------- */
+@media (prefers-reduced-motion: reduce) {
+  .oq-recado, .oq-recado--saindo, .oq-recado__arte img, .oq-gato, .fc-carta.oq-reflexo,
+  .cabecalho__marca.oq-tinel .cabecalho__selo, .cabecalho__marca.oq-tinel::after { animation: none; }
+  .oq-recado--saindo { opacity: 0; transition: opacity 0.2s; }
+  .oq-confete, .oq-estrela-cadente, .oq-danca { display: none; }
+}
