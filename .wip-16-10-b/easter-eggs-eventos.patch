@@ -0,0 +1,192 @@
+/**
+ * Frases das surpresas (eventos aleatórios e easter eggs). Tom de colega de plantão: caloroso,
+ * leve, sem cobrança (docs/emails/TOM.md). Regras fixas: nunca o total de questões do acervo,
+ * nunca nome de outra marca, e fora do jogo o nome é "Flashcards". O teste
+ * fixtures/testar_eventos.mjs confere essas regras em todas as listas.
+ */
+import type { Personagem } from './regras'
+
+export const FRASES_CAFE = [
+  'Pausa de trinta segundos para o café? O fêmur espera, prometo.',
+  'Um gole de café e a próxima questão fica mais fácil. Ciência de plantão.',
+  'Café passado, cabeça fresca. Bora mais uma?',
+  'Hidratação também conta. Café vale, água vale mais. Os dois, melhor ainda.',
+  'O café chegou quentinho. Respira, estica as costas e segue no seu ritmo.',
+] as const
+
+export const FRASES_BILHETE = [
+  'Deixaram na prancheta: "Leia o comentário mesmo quando acertar. É lá que mora o detalhe da prova."',
+  'Recado na prancheta: "Classificação se aprende repetindo. Errar hoje é acertar em janeiro."',
+  'Bilhete do plantão: "Revisão feita vale mais que questão nova esquecida."',
+  'Na prancheta, com letra de médico: "Orgulho de ver você aqui de novo."',
+  'Anotado na prancheta: "Dúvida marcada é questão que volta na hora certa. Confia no processo."',
+  'Recado do preceptor: "Ninguém lembra de tudo. Quem passa é quem volta no que esqueceu."',
+] as const
+
+export const FRASES_MASCOTE = [
+  'O cavaleiro passou só para dizer que está torcendo por você.',
+  'Visita rápida do mascote: armadura brilhando, escudo erguido, e você mandando bem.',
+  'O mascote acenou de longe. Disse que hoje o dia rende.',
+  'Psiu, o cavaleiro deixou um recado: "Uma questão de cada vez, como quem sobe escada."',
+] as const
+
+export const FRASES_ESTRELA = [
+  'Uma estrela cadente! Faça um pedido. O meu é que caia a sua matéria favorita.',
+  'Passou uma estrela cadente. Dizem que dá sorte para quem estuda até tarde.',
+  'Estrela cadente avistada. Pedido sugerido: memória boa para epônimos.',
