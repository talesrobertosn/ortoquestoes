+// Ponta a ponta no BUILD DE PRODUÇÃO: surpresas (eventos aleatórios) e easter eggs, com relógio
+// falso do Playwright e o parâmetro de teste ?surpresa=<id>. Confere bloqueios (simulado,
+// preferência desligada), movimento reduzido e tira capturas em computador e celular.
+//
+// Uso: node fixtures/e2e_eventos.mjs   (CAPTURAS=/pasta, CHROMIUM=/caminho, SEM_BUILD=1)
+import assert from 'node:assert/strict'
+import { execFileSync, spawn } from 'node:child_process'
+import { mkdir } from 'node:fs/promises'
+import { join } from 'node:path'
+
+const raiz = process.cwd()
+const SUPABASE = 'https://falso.supabase.co'
+const CONTA = '11111111-2222-4333-8444-555555555555'
+const capturas = process.env.CAPTURAS ?? '/tmp/claude-0/capturas-eventos'
+await mkdir(capturas, { recursive: true })
+const { chromium } = await import('playwright')
+
+const env = { ...process.env, VITE_SUPABASE_URL: SUPABASE, VITE_SUPABASE_PUBLISHABLE_KEY: 'sb_publishable_simulado', VITE_FLASHCARDS: '1' }
+if (!process.env.SEM_BUILD) execFileSync('npx', ['vite', 'build', '--logLevel', 'error'], { cwd: raiz, env, stdio: 'inherit' })
+const porta = 4300 + Math.floor(Math.random() * 500)
+const preview = spawn('npx', ['vite', 'preview', '--port', String(porta), '--strictPort'], { cwd: raiz, env, stdio: ['ignore', 'pipe', 'inherit'] })
+preview.stdout.resume()
+const BASE = `http://localhost:${porta}/`
+for (let i = 0; ; i++) {
+  if (await fetch(BASE).then((r) => r.ok, () => false)) break
+  if (i > 120) throw new Error('vite preview não subiu')
+  await new Promise((ok) => setTimeout(ok, 250))
+}
+
+const usuario = (meta = {}) => ({ id: CONTA, aud: 'authenticated', role: 'authenticated', email: 'ana@exemplo.com', app_metadata: { provider: 'email' }, user_metadata: { nome: 'Ana', ...meta }, created_at: '2026-09-01T00:00:00Z' })
+function atendente(meta) {
+  return async (rota) => {
+    const pedido = rota.request()
+    const url = new URL(pedido.url())
+    const cors = { 'access-control-allow-origin': '*', 'access-control-allow-headers': '*', 'access-control-allow-methods': '*', 'access-control-expose-headers': '*' }
+    if (pedido.method() === 'OPTIONS') return rota.fulfill({ status: 204, headers: cors })
+    const responder = (corpo) => rota.fulfill({ status: 200, headers: { ...cors, 'content-type': 'application/json' }, body: JSON.stringify(corpo) })
+    if (url.pathname.startsWith('/auth/v1/user')) return responder(usuario(meta))
+    if (url.pathname.startsWith('/auth/v1/')) return responder({})
+    const rpc = url.pathname.match(/^\/rest\/v1\/rpc\/([a-z_]+)$/)?.[1]
+    if (rpc === 'obter_acesso_premium') return responder([{ premium: true, motivo: 'assinatura', recursos_exclusivos: true, pagamentos_ativos: true }])
+    if (rpc === 'obter_estado_conta') return responder([{ status_assinatura: 'ativa', cancelar_ao_fim: false, fim_periodo: null }])
+    if (rpc === 'sinal_aparelho') return responder([{ ativo: true, outro_aparelho: null }])
+    if (rpc === 'sincronizar_progresso' || rpc === 'ler_progresso_desde') return responder([])
+    return responder(rpc ? null : [])
+  }
+}
+
+const TELAS = [{ nome: 'computador', viewport: { width: 1400, height: 860 } }, { nome: 'celular', viewport: { width: 390, height: 844 }, isMobile: true, hasTouch: true, deviceScaleFactor: 2 }]
+const navegador = await chromium.launch({ executablePath: process.env.CHROMIUM ?? '/opt/pw-browsers/chromium', args: ['--no-sandbox'] })
+const erros = []
+
+/** Abre uma página com conta simulada, relógio falso e dados locais. */
+async function abrir(tela, { hora, meta = {}, locais = {}, escuro = false, reduzido = false } = {}) {
+  const contexto = await navegador.newContext({ viewport: tela.viewport, isMobile: tela.isMobile, hasTouch: tela.hasTouch, deviceScaleFactor: tela.deviceScaleFactor ?? 1, colorScheme: escuro ? 'dark' : 'light', reducedMotion: reduzido ? 'reduce' : 'no-preference' })
+  await contexto.route(`${SUPABASE}/**`, atendente(meta))
+  const sessao = { access_token: `tok-${CONTA}`, refresh_token: 'r', token_type: 'bearer', expires_in: 3600, expires_at: Math.floor(new Date(hora ?? Date.now()).getTime() / 1000) + 30 * 24 * 3600, user: usuario(meta) }
+  await contexto.addInitScript(([s, conta, extra, tema]) => {
+    if (sessionStorage.getItem('oq-teste-semeado')) return
+    sessionStorage.setItem('oq-teste-semeado', '1')
+    localStorage.setItem('sb-ortoquestoes-auth', s)
+    localStorage.setItem('ortoquestoes:tema', JSON.stringify(tema))
+    for (const [k, v] of Object.entries(extra)) localStorage.setItem(k.replace('@', `ortoquestoes:conta:${conta}:`), JSON.stringify(v))
+  }, [JSON.stringify(sessao), CONTA, locais, escuro ? 'escuro' : 'claro'])
+  const p = await contexto.newPage()
+  if (hora) await p.clock.install({ time: new Date(hora) })
+  p.on('pageerror', (e) => erros.push(`${tela.nome}: ${e.message}`))
+  return { p, contexto }
+}
+
+const recado = '.oq-recado'
+async function esperarRecado(p, id) {
+  await p.waitForSelector(`${recado}[data-surpresa="${id}"]`, { timeout: 15_000 })
+  await p.waitForTimeout(700)
+}
+
+try {
+  for (const tela of TELAS) {
+    const c = (nome) => join(capturas, `${tela.nome}-${nome}.png`)
+
+    // 1. Fim de semana: "Sábado, 15h, e você aqui".
+    console.log(`${tela.nome}: passo 1`)
+    {
+      const { p, contexto } = await abrir(tela, { hora: '2026-10-17T15:00:00' })
+      await p.goto(BASE + '#/?surpresa=fim-de-semana')
+      await esperarRecado(p, 'fim-de-semana')
+      const texto = await p.locator(recado).innerText()
+      assert.match(texto, /Sábado, 15h/, texto)
+      await p.screenshot({ path: c('fim-de-semana') })
+      await contexto.close()
+    }
+    // 2. Madrugada (sorteio de verdade, ?surpresa=agora) + luazinha do plantão na logo, tema escuro.
+    console.log(`${tela.nome}: passo 2`)
+    {
+      const { p, contexto } = await abrir(tela, { hora: '2026-10-15T02:40:00', escuro: true })
+      await p.goto(BASE + '#/treinar?surpresa=agora')
+      await p.waitForFunction(() => document.body.classList.contains('oq-plantao'), null, { timeout: 15_000 })
+      // O sorteio da madrugada tem 50%: tenta algumas vezes recarregando.
+      let ok = false
+      for (let i = 0; i < 8 && !ok; i++) {
+        ok = await p.waitForSelector(`${recado}[data-surpresa="madrugada"]`, { timeout: 5000 }).then(() => true, () => false)
+        if (!ok) { await p.evaluate(() => localStorage.removeItem(Object.keys(localStorage).find((k) => k.endsWith('eventos:memoria')) ?? 'x')); await p.reload() }
+      }
+      if (!ok) console.log(await p.evaluate(() => [location.hash, document.body.className, document.querySelector('main')?.innerText.slice(0, 200), JSON.stringify(Object.entries(localStorage).filter(([k]) => k.includes('eventos')))]))
+      assert.ok(ok, 'madrugada não apareceu')
+      await p.waitForTimeout(700)
+      await p.screenshot({ path: c('madrugada') })
+      await contexto.close()
+    }
+    // 3. Aniversário da pessoa (data de nascimento do perfil), com confete.
+    console.log(`${tela.nome}: passo 3`)
+    {
+      const { p, contexto } = await abrir(tela, { hora: '2026-10-21T11:00:00', meta: { nascimento: '1995-10-21' } })
+      await p.goto(BASE + '#/?surpresa=agora')
+      await esperarRecado(p, 'aniversario')
+      assert.match(await p.locator(recado).innerText(), /Parabéns, Ana!/)
+      await p.waitForTimeout(300)
+      await p.screenshot({ path: c('aniversario') })
+      await contexto.close()
+    }
+    // 4. Simulado em andamento: nada aparece, nem forçado.
+    console.log(`${tela.nome}: passo 4`)
+    {
+      const agora = new Date('2026-10-15T14:00:00').getTime()
+      const simulado = { id: 's', criadaEm: agora - 10 * 60_000, filtros: {}, ids: ['ombro-1', 'ombro-2'], posicao: 0, respostas: {}, revisar: [], riscadas: {}, concluidaEm: null, simulado: true, limiteSegundos: 3600 }
+      const { p, contexto } = await abrir(tela, { hora: agora, locais: { '@sessao:atual': simulado } })
+      await p.goto(BASE + '#/?surpresa=cafe')
+      await p.waitForTimeout(6000)
+      assert.equal(await p.locator(recado).count(), 0, 'surpresa apareceu durante o simulado')
+      await contexto.close()
+    }
+    // 5. Preferência desligada: nada aparece.
