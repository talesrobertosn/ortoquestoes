+def desenhar(nome: str) -> Image.Image:
+    paleta, linhas = DESENHOS[nome]
+    img = Image.new("RGBA", (LADO, LADO), (0, 0, 0, 0))
+    px = img.load()
+    assert len(linhas) == LADO, f"{nome}: {len(linhas)} linhas"
+    for y, linha in enumerate(linhas):
+        linha = linha.ljust(LADO, ".")[:LADO]
+        for x, ch in enumerate(linha):
+            if ch == ".":
+                continue
+            cor = paleta.get(ch)
+            assert cor, f"{nome}: letra sem cor '{ch}' na linha {y}"
+            h = cor.lstrip("#")
+            px[x, y] = (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16), 255)
+    return img
+
+
+def main() -> None:
+    PASTA.mkdir(parents=True, exist_ok=True)
+    imagens = {nome: desenhar(nome) for nome in DESENHOS}
+    for nome, img in imagens.items():
+        img.save(PASTA / f"{nome}.png", optimize=True)
+    if "--folha" in sys.argv:
+        destino = Path(sys.argv[sys.argv.index("--folha") + 1])
+        escala = 8
+        folha = Image.new("RGBA", (len(imagens) * (LADO * escala + 16) + 16, LADO * escala + 32), (40, 44, 52, 255))
+        for i, img in enumerate(imagens.values()):
+            folha.alpha_composite(img.resize((LADO * escala, LADO * escala), Image.NEAREST), (16 + i * (LADO * escala + 16), 16))
+        folha.save(destino)
+    print(f"{len(imagens)} personagens em {PASTA}")
+
+
+if __name__ == "__main__":
+    main()
