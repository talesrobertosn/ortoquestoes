+/**
+ * Sala secreta "Arquivo do Preceptor" (easter egg). Não aparece em menu nenhum: chega-se pelo
+ * código ortopédico, pelo recado no console ou pela fratura reduzida da página de erro.
+ * Mostra as gavetas (eggs) já encontradas neste aparelho, sem contar como achar as outras, e os
+ * selos locais (Mão de cirurgião). Nada aqui vale ponto, ranking ou acesso.
+ */
+import { useEffect, useState } from 'react'
+import { recurso } from '../config'
+import { href } from '../util/rotas'
+import { lerMemoria, marcarAchado } from '../eventos/memoria'
+import { ACHADOS, type Memoria } from '../eventos/regras'
+import '../eventos/arquivo.css'
+
+const ANOTACOES = [
+  'Leia o enunciado inteiro antes das alternativas. A banca esconde a resposta no meio da frase.',
+  'Errou? Ótimo. Erro comentado é o que mais rende na revisão.',
+  'Classificação se aprende desenhando. Rabisque a fratura no papel e dê o nome.',
+  'Epônimo esquecido não é vergonha: anote, revise e ele volta na hora certa.',
+  'Um pouco todo dia vence muito de vez em quando. A sequência é a sua melhor amiga.',
+  'Na véspera, durma. Ninguém aprende ombro às três da manhã do dia da prova.',
+]
+
+export function ArquivoPreceptor({ consulta }: { consulta?: URLSearchParams }) {
+  const [memoria, definirMemoria] = useState<Memoria>(() => lerMemoria())
+  useEffect(() => {
+    marcarAchado('arquivo')
+    if (consulta?.get('de') === 'console') marcarAchado('console')
+    definirMemoria(lerMemoria())
+  }, [consulta])
+  const achados = new Set(memoria.achados)
+  const mao = memoria.selos['mao-de-cirurgiao']
+
+  return (
+    <article className="arq empilha-2 limite-leitura">
+      <header className="arq__porta">
+        <img className="arq__esqueleto" src={recurso('pixel/surpresas/esqueleto.png')} width={20} height={20} alt="" />
+        <div>
+          <p className="arq__sobre">Sala nos fundos · luz fraca · cheiro de papel antigo</p>
+          <h1>Arquivo do Preceptor</h1>
+          <p>Você achou a sala que pouca gente acha. Fique à vontade: o preceptor deixou umas anotações.</p>
+        </div>
+      </header>
+
+      <section className="arq__cartao">
+        <h2>Anotações na gaveta de cima</h2>
+        <ul className="arq__anotacoes">
+          {ANOTACOES.map((a) => <li key={a}>{a}</li>)}
+        </ul>
+      </section>
+
+      <section className="arq__cartao">
+        <h2>Gavetas encontradas <small>{achados.size} de {ACHADOS.length}</small></h2>
+        <ul className="arq__gavetas">
+          {ACHADOS.map(([id, nome]) => (
+            <li key={id} className={achados.has(id) ? 'arq__gaveta arq__gaveta--aberta' : 'arq__gaveta'}>
+              <span aria-hidden="true">{achados.has(id) ? '✦' : '?'}</span>
+              {achados.has(id) ? nome : 'Gaveta trancada'}
+            </li>
+          ))}
+        </ul>
+        <p className="arq__nota">As gavetas ficam guardadas neste aparelho. Não valem ponto nem ranking: são só para sorrir.</p>
+      </section>
+
+      {mao && (
+        <section className="arq__cartao arq__selo">
+          <img src={recurso('pixel/surpresas/mao.png')} width={20} height={20} alt="" />
+          <div>
+            <h2>Selo: Mão de cirurgião</h2>
+            <p>Vinte acertos seguidos, todos com certeza. Conquistado em {mao.split('-').reverse().join('/')}.</p>
+          </div>
+        </section>
+      )}
+
+      <p><a className="botao" href={href('/')}>Voltar ao início</a></p>
+    </article>
+  )
+}
