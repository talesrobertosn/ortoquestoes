+    if (typeof v === 'string') textos.push(v)
+    else if (Array.isArray(v)) textos.push(...v.filter((x) => typeof x === 'string'))
+    else if (v && typeof v === 'object') for (const x of Object.values(v)) textos.push(...(Array.isArray(x) ? x : [x.titulo, x.frase].filter(Boolean)))
+  }
+  for (const marco of m.MARCOS_RESPOSTAS) textos.push(m.F.fraseMarco(marco, 'Ana'))
+  textos.push(m.F.fraseRecorde(40))
+  for (let i = 0; i < 8; i++) textos.push(m.F.fraseFimDeSemana(sabado(), '15h', () => i / 8))
+  assert.ok(textos.length > 80, `${textos.length} frases`)
+  const proibidas = /cripta|masmorra|infelizmente|vou ser (direto|sincero)|sem rodeios|só que|olha só|grátis|desconto|oferta|aproveite/i
+  for (const t of textos) {
+    assert.ok(!proibidas.test(t), `Frase fora do tom ou das regras: ${t}`)
+    assert.ok(!t.includes(String(indice.total)) && !t.includes(indice.total.toLocaleString('pt-BR')), `Frase cita o total: ${t}`)
+  }
+  console.log(`Eventos e easter eggs: bloqueios, frequência, madrugada, fim de semana, datas, marcos, eggs e ${textos.length} frases conferidos`)
+} finally {
+  await rm(pasta, { recursive: true, force: true })
+}
