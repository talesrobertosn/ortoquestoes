+/**
+ * Regras puras dos eventos aleatórios e dos easter eggs (combinados com o Tales em 16/10/2026).
+ *
+ * Nada aqui toca a tela, o relógio ou o armazenamento: tudo chega pelo contexto (hora, rota,
+ * sessão, preferência, memória do que já apareceu) e o sorteio é uma função passada de fora.
+ * Assim `fixtures/testar_eventos.mjs` testa cada caso com relógio falso.
+ *
+ * Princípios:
+ * - nunca no meio de uma questão nem em simulado;
+ * - frequência baixa (intervalo mínimo e teto por dia), sem repetir a mesma surpresa em seguida;
+ * - nada mexe em contagem, ranking ou acesso: é só um recado que some sozinho.
+ *
+ * Documentação: docs/EASTER-EGGS-E-EVENTOS.md.
+ */
+import {
+  FRASES_ANIVERSARIO, FRASES_ANIVERSARIO_CONTA, FRASES_BILHETE, FRASES_BISCOITO, FRASES_CAFE, FRASES_CONFETE,
+  FRASES_DIA_ORTOPEDISTA, FRASES_DIA_PROVA, FRASES_ESTRELA, FRASES_HORA, FRASES_MADRUGADA, FRASES_MASCOTE,
+  FRASES_SEXTA, FRASES_VESPERA, DATAS_ESPECIAIS, fraseFimDeSemana, fraseMarco, fraseRecorde, FRASES_R1, FRASES_MAO,
+} from './frases'
+
+export const MINUTO = 60_000
+/** Intervalo mínimo entre duas surpresas automáticas. */
+export const INTERVALO_MINIMO = 15 * MINUTO
+/** De madrugada a surpresa pode voltar mais cedo (pedido do Tales), com outra frase. */
+export const INTERVALO_MADRUGADA = 6 * MINUTO
+/** Teto de surpresas automáticas por dia. */
+export const MAXIMO_POR_DIA = 6
+/** Chance, a cada verificação (uma por minuto), de uma surpresa comum aparecer. */
+export const CHANCE_ALEATORIA = 0.12
+/** Chance da madrugada, a cada verificação já passado o intervalo. */
+export const CHANCE_MADRUGADA = 0.5
+/** Simulado abandonado há mais que isso deixa de segurar as surpresas. */
+export const SIMULADO_VALE_POR = 6 * 60 * MINUTO
+/** Festa nas respostas de número 1.000, 5.000 e 10.000. */
+export const MARCOS_RESPOSTAS = [1000, 5000, 10000] as const
+/** Dia do Ortopedista (19 de setembro). */
+export const DIA_ORTOPEDISTA = '09-19'
+
+export type Personagem =
+  | 'cafe' | 'prancheta' | 'mascote' | 'estrela' | 'biscoito' | 'bolo' | 'lua' | 'sol' | 'r1'
+  | 'esqueleto' | 'mao' | 'martelo' | 'medalha' | 'gato' | 'confete'
+
+export type IdEvento =
+  | 'marco' | 'aniversario' | 'aniversario-conta' | 'vespera-teot' | 'dia-prova' | 'dia-ortopedista' | 'data-especial'
+  | 'mao-de-cirurgiao' | 'recorde' | 'r1-sem-dormir' | 'madrugada' | 'fim-de-semana' | 'sexta-noite'
+  | 'cafe' | 'bilhete' | 'mascote' | 'estrela' | 'confete' | 'hora' | 'biscoito'
+
+export interface Evento {
+  id: IdEvento
+  personagem: Personagem
+  titulo?: string
+  frase: string
+  /** Quanto tempo fica na tela antes de sumir sozinho. */
+  duracaoMs: number
+  /** Efeito por cima (só sem prefers-reduced-motion). */
+  efeito?: 'confete' | 'estrela' | null
+  /** Chave de "já vi": o evento único não volta enquanto a chave for a mesma (dia, ano, marco). */
+  chave?: string
+}
+
+/** O que importa da sessão de questões (estado `sessao:atual`). */
+export interface SessaoResumo {
+  concluida: boolean
+  criadaEm: number
+  simulado?: boolean
+  limiteSegundos?: number | null
+  nacional?: string
+  /** A questão da posição atual ainda não foi respondida. */
+  questaoAtualAberta: boolean
+}
+
+export interface Memoria {
+  /** Última surpresa automática (instante). */
+  ultimoEm: number | null
+  /** Última surpresa (id), para não repetir em seguida. */
+  ultimoId: string | null
+  /** Últimas frases mostradas (as mais recentes no fim). */
+  frases: string[]
+  /** Surpresas únicas já vistas: id → chave (dia, ano ou marco). */
+  vistos: Record<string, string>
+  /** Contagem do dia: [chave do dia, quantas]. */
+  dia: [string, number]
+  /** Marcos de respostas já festejados. */
+  marcos: number[]
+  /** Marco atingido esperando a hora certa (fora de questão e de simulado). */
+  marcoPendente: number | null
+  /** Easter eggs encontrados (para o Arquivo do Preceptor). */
+  achados: string[]
+  /** Selos locais (ex.: Mão de cirurgião): id → data em que foi conquistado. */
+  selos: Record<string, string>
+}
+
+export const MEMORIA_VAZIA: Memoria = { ultimoEm: null, ultimoId: null, frases: [], vistos: {}, dia: ['', 0], marcos: [], marcoPendente: null, achados: [], selos: {} }
+
+/** Normaliza o que veio do armazenamento (versões antigas, lixo, nada). */
+export function normalizarMemoria(bruto: unknown): Memoria {
+  const m = (bruto && typeof bruto === 'object' ? bruto : {}) as Partial<Memoria>
+  const lista = (v: unknown): unknown[] => Array.isArray(v) ? v : []
+  const objeto = (v: unknown): Record<string, string> => v && typeof v === 'object' && !Array.isArray(v) ? { ...(v as Record<string, string>) } : {}
+  return {
+    ultimoEm: typeof m.ultimoEm === 'number' ? m.ultimoEm : null,
+    ultimoId: typeof m.ultimoId === 'string' ? m.ultimoId : null,
+    frases: lista(m.frases).filter((f): f is string => typeof f === 'string').slice(-12),
+    vistos: objeto(m.vistos),
+    dia: Array.isArray(m.dia) && typeof m.dia[0] === 'string' && typeof m.dia[1] === 'number' ? [m.dia[0], m.dia[1]] : ['', 0],
+    marcos: lista(m.marcos).filter((n): n is number => typeof n === 'number'),
+    marcoPendente: typeof m.marcoPendente === 'number' ? m.marcoPendente : null,
+    achados: lista(m.achados).filter((f): f is string => typeof f === 'string'),
+    selos: objeto(m.selos),
+  }
+}
+
+export interface Contexto {
+  agora: Date
+  /** Segmentos da rota (#/sessao → ['sessao']). */
+  segmentos: string[]
+  /** A rota é o jogo dos flashcards (pop-up). */
+  jogo?: boolean
+  sessao: SessaoResumo | null
+  desligado: boolean
+  movimentoReduzido: boolean
+  memoria: Memoria
+  /** "AAAA-MM-DD" do perfil (Minha conta). */
+  nascimento?: string | null
+  /** created_at da conta (ISO). */
+  contaCriadaEm?: string | null
+  nome?: string
+  /** Respostas de hoje e o melhor dia anterior (recorde pessoal). */
+  respostasHoje?: number
+  melhorDiaAnterior?: number
+  /** Noites diferentes com resposta entre 0h e 5h nos últimos 7 dias. */
+  madrugadasNaSemana?: number
+  /** As 20 últimas respostas foram certas e com certeza. */
+  maoDeCirurgiao?: boolean
+  /** Data da prova que o site conhece ("AAAA-MM-DD"). */
+  dataProva: string
+}
+
+// ---------- Datas (relógio do aparelho: a surpresa fala da hora que a pessoa vê) ----------
+
+const dois = (n: number) => String(n).padStart(2, '0')
+export const chaveLocal = (d: Date) => `${d.getFullYear()}-${dois(d.getMonth() + 1)}-${dois(d.getDate())}`
+export const mesDia = (d: Date) => `${dois(d.getMonth() + 1)}-${dois(d.getDate())}`
+const bissexto = (a: number) => (a % 4 === 0 && a % 100 !== 0) || a % 400 === 0
+function diaDe(chave: string): Date | null {
+  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(chave ?? '')
+  if (!m) return null
+  const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]), 12)
+  return Number.isNaN(d.getTime()) ? null : d
+}
+const meioDia = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate(), 12).getTime()
+const diasEntre = (a: Date, b: Date) => Math.round((meioDia(b) - meioDia(a)) / 86_400_000)
+
+/** Hoje é o aniversário de quem nasceu em `nascimento` (29/02 vira 28/02 em ano comum). */
+export function ehAniversario(nascimento: string | null | undefined, agora: Date): boolean {
+  const n = diaDe(nascimento ?? '')
+  if (!n) return false
+  let md = mesDia(n)
+  if (md === '02-29' && !bissexto(agora.getFullYear())) md = '02-28'
+  return md === mesDia(agora)
+}
+
+/** Anos (ou 100 dias) de conta completados hoje; null se hoje não é data redonda. */
+export function aniversarioDaConta(criadaEm: string | null | undefined, agora: Date): { anos: number; dias: number } | null {
+  if (!criadaEm) return null
+  const c = new Date(criadaEm)
+  if (Number.isNaN(c.getTime())) return null
+  const dias = diasEntre(c, agora)
+  if (dias === 100) return { anos: 0, dias }
+  const anos = agora.getFullYear() - c.getFullYear()
+  return anos >= 1 && mesDia(c) === mesDia(agora) ? { anos, dias } : null
+}
+
+export const ehMadrugada = (agora: Date) => agora.getHours() < 5
+export const ehFimDeSemana = (agora: Date) => agora.getDay() === 0 || agora.getDay() === 6
+export const ehSextaNoite = (agora: Date) => agora.getDay() === 5 && agora.getHours() >= 19
+/** Plantão da madrugada (easter egg visual da logo): das 0h às 5h. */
+export const ehPlantao = ehMadrugada
+
+export function ehVespera(dataProva: string, agora: Date): boolean {
+  const p = diaDe(dataProva)
+  return !!p && diasEntre(agora, p) === 1
+}
+export function ehDiaDaProva(dataProva: string, agora: Date): boolean {
+  const p = diaDe(dataProva)
+  return !!p && diasEntre(agora, p) === 0
+}
+
+/** "15h" ou "15h40". */
+export function horaFalada(agora: Date): string {
+  const m = agora.getMinutes()
+  return `${agora.getHours()}h${m ? dois(m) : ''}`
+}
+
+// ---------- Quando não aparece ----------
+
+export type Bloqueio = 'desligado' | 'simulado' | 'questao' | 'jogo' | 'ferramenta' | null
+
+/** Sessão cronometrada, Simulado Nacional ou prova do cronograma em andamento. */
+export function simuladoEmAndamento(sessao: SessaoResumo | null, agora: Date): boolean {
+  if (!sessao || sessao.concluida) return false
+  const prova = !!sessao.simulado || !!sessao.limiteSegundos || !!sessao.nacional
+  return prova && agora.getTime() - sessao.criadaEm < SIMULADO_VALE_POR
+}
+
+/**
+ * Por que a surpresa automática não pode aparecer agora (null = pode).
+ * Os eggs que a própria pessoa aciona (Konami, Tinel, gato, martelo, 404) não passam por aqui:
+ * acontecem quando ela quer, mas também nunca em simulado (ver eggPermitido).
+ */
+export function bloqueio(ctx: Pick<Contexto, 'agora' | 'segmentos' | 'jogo' | 'sessao' | 'desligado'>): Bloqueio {
+  if (ctx.desligado) return 'desligado'
+  const [primeiro] = ctx.segmentos
+  if (primeiro === 'simulado-nacional' || simuladoEmAndamento(ctx.sessao, ctx.agora)) return 'simulado'
+  if (primeiro === 'questao') return 'questao'
+  if (primeiro === 'sessao' && ctx.sessao && !ctx.sessao.concluida && ctx.sessao.questaoAtualAberta) return 'questao'
+  if (ctx.jogo) return 'jogo'
+  if (primeiro === 'admin' || primeiro === 'emails') return 'ferramenta'
+  return null
+}
+
+/** Eggs acionados pela pessoa: só o simulado segura. */
+export function eggPermitido(ctx: Pick<Contexto, 'agora' | 'segmentos' | 'sessao'>): boolean {
+  return ctx.segmentos[0] !== 'simulado-nacional' && !simuladoEmAndamento(ctx.sessao, ctx.agora)
+}
+
+// ---------- Escolha ----------
+
+/** Escolhe uma frase evitando as mais recentes. */
+export function escolherFrase(lista: readonly string[], recentes: readonly string[], sortear: () => number): string {
+  const livres = lista.filter((f) => !recentes.includes(f))
+  const de = livres.length ? livres : lista
+  return de[Math.min(de.length - 1, Math.floor(sortear() * de.length))]
+}
+
+const SEGUNDOS = 1000
+const COMUNS: Array<{ id: IdEvento; personagem: Personagem; frases: readonly string[]; efeito?: 'confete' | 'estrela'; peso: number; titulo?: string }> = [
+  { id: 'cafe', personagem: 'cafe', frases: FRASES_CAFE, peso: 3, titulo: 'Café de plantão' },
+  { id: 'bilhete', personagem: 'prancheta', frases: FRASES_BILHETE, peso: 3, titulo: 'Bilhete na prancheta' },
+  { id: 'mascote', personagem: 'mascote', frases: FRASES_MASCOTE, peso: 2 },
+  { id: 'estrela', personagem: 'estrela', frases: FRASES_ESTRELA, efeito: 'estrela', peso: 1, titulo: 'Estrela cadente' },
+  { id: 'confete', personagem: 'confete', frases: FRASES_CONFETE, efeito: 'confete', peso: 1 },
+  { id: 'hora', personagem: 'sol', frases: [], peso: 3 },
+  { id: 'biscoito', personagem: 'biscoito', frases: FRASES_BISCOITO, peso: 2, titulo: 'Biscoito da sorte' },
+]
+
+function faseDoDia(agora: Date): keyof typeof FRASES_HORA {
+  const h = agora.getHours()
+  return h < 12 ? 'manha' : h < 18 ? 'tarde' : 'noite'
+}
+
+/**
+ * Surpresas únicas do dia, em ordem de prioridade. Cada uma tem uma chave: aparece uma vez por
+ * chave (o aniversário uma vez por ano, o recorde uma vez por dia, a mão de cirurgião uma vez só).
+ */
+export function eventosUnicos(ctx: Contexto): Evento[] {
+  const { agora, memoria } = ctx
+  const ano = String(agora.getFullYear())
+  const hoje = chaveLocal(agora)
+  const nome = ctx.nome?.trim().split(/\s+/)[0] ?? ''
+  const lista: Evento[] = []
+  const r = (frases: readonly string[]) => frases[(agora.getDate() + agora.getMonth()) % frases.length]
+  const marco = memoria.marcoPendente
+  if (marco && !memoria.marcos.includes(marco)) lista.push({ id: 'marco', personagem: 'confete', titulo: 'Festa!', frase: fraseMarco(marco, nome), duracaoMs: 7 * SEGUNDOS, efeito: 'confete', chave: String(marco) })
+  if (ehAniversario(ctx.nascimento, agora)) lista.push({ id: 'aniversario', personagem: 'bolo', titulo: nome ? `Parabéns, ${nome}!` : 'Parabéns!', frase: r(FRASES_ANIVERSARIO), duracaoMs: 7 * SEGUNDOS, efeito: 'confete', chave: ano })
+  const conta = aniversarioDaConta(ctx.contaCriadaEm, agora)
+  if (conta) lista.push({ id: 'aniversario-conta', personagem: 'bolo', titulo: conta.anos ? `${conta.anos} ${conta.anos === 1 ? 'ano' : 'anos'} de estudo juntos` : '100 dias de estudo juntos', frase: r(FRASES_ANIVERSARIO_CONTA), duracaoMs: 6 * SEGUNDOS, efeito: 'confete', chave: hoje })
+  if (ehDiaDaProva(ctx.dataProva, agora)) lista.push({ id: 'dia-prova', personagem: 'mascote', titulo: 'Hoje é o dia', frase: r(FRASES_DIA_PROVA), duracaoMs: 7 * SEGUNDOS, chave: hoje })
+  if (ehVespera(ctx.dataProva, agora)) lista.push({ id: 'vespera-teot', personagem: 'lua', titulo: 'Véspera do TEOT', frase: r(FRASES_VESPERA), duracaoMs: 7 * SEGUNDOS, chave: hoje })
+  if (mesDia(agora) === DIA_ORTOPEDISTA) lista.push({ id: 'dia-ortopedista', personagem: 'medalha', titulo: 'Dia do Ortopedista', frase: r(FRASES_DIA_ORTOPEDISTA), duracaoMs: 6 * SEGUNDOS, efeito: 'confete', chave: hoje })
+  const especial = DATAS_ESPECIAIS[mesDia(agora)]
+  if (especial) lista.push({ id: 'data-especial', personagem: especial.personagem, titulo: especial.titulo, frase: especial.frase, duracaoMs: 6 * SEGUNDOS, chave: hoje })
+  if (ctx.maoDeCirurgiao && !memoria.selos['mao-de-cirurgiao']) lista.push({ id: 'mao-de-cirurgiao', personagem: 'mao', titulo: 'Selo: Mão de cirurgião', frase: r(FRASES_MAO), duracaoMs: 7 * SEGUNDOS, chave: 'sempre' })
+  const hojeN = ctx.respostasHoje ?? 0, melhor = ctx.melhorDiaAnterior ?? 0
+  if (hojeN >= 30 && melhor >= 20 && hojeN > melhor) lista.push({ id: 'recorde', personagem: 'medalha', titulo: 'Recorde pessoal', frase: fraseRecorde(hojeN), duracaoMs: 6 * SEGUNDOS, chave: hoje })
+  if ((ctx.madrugadasNaSemana ?? 0) >= 3) {
+    // Uma vez por semana (a chave é a segunda-feira da semana).
+    const segunda = new Date(agora.getFullYear(), agora.getMonth(), agora.getDate() - ((agora.getDay() + 6) % 7), 12)
+    lista.push({ id: 'r1-sem-dormir', personagem: 'r1', titulo: 'R1 sem dormir', frase: r(FRASES_R1), duracaoMs: 6 * SEGUNDOS, chave: chaveLocal(segunda) })
+  }
+  return lista.filter((e) => memoria.vistos[e.id] !== e.chave)
+}
+
+/**
+ * A surpresa automática da vez, ou null. `sortear` devolve um número em [0, 1).
+ * Ordem: bloqueios → únicas do dia (não dependem de sorteio, só do intervalo curto) → teto do
+ * dia → madrugada → fim de semana / sexta à noite (uma vez por dia) → comuns, com chance baixa.
+ */
+export function escolherEvento(ctx: Contexto, sortear: () => number = Math.random): Evento | null {
+  if (bloqueio(ctx)) return null
+  const { agora, memoria } = ctx
+  const t = agora.getTime()
+  const hoje = chaveLocal(agora)
+  const doDia = memoria.dia[0] === hoje ? memoria.dia[1] : 0
+  const desde = memoria.ultimoEm === null ? Infinity : t - memoria.ultimoEm
+  const unicos = eventosUnicos(ctx)
+  if (unicos.length && desde >= INTERVALO_MADRUGADA) return unicos[0]
+  if (doDia >= MAXIMO_POR_DIA) return null
+
+  if (ehMadrugada(agora)) {
+    if (desde < INTERVALO_MADRUGADA || sortear() >= CHANCE_MADRUGADA) return null
+    const frase = escolherFrase(FRASES_MADRUGADA, memoria.frases, sortear)
+    return { id: 'madrugada', personagem: sortear() < 0.5 ? 'lua' : 'cafe', titulo: horaFalada(agora), frase, duracaoMs: 5 * SEGUNDOS }
+  }
+  if (desde < INTERVALO_MINIMO) return null
+
+  if (ehFimDeSemana(agora) && agora.getHours() >= 8 && memoria.vistos['fim-de-semana'] !== hoje) {
+    return { id: 'fim-de-semana', personagem: 'mascote', frase: fraseFimDeSemana(agora, horaFalada(agora), sortear), duracaoMs: 4500, chave: hoje }
+  }
+  if (ehSextaNoite(agora) && memoria.vistos['sexta-noite'] !== hoje) {
+    return { id: 'sexta-noite', personagem: 'lua', titulo: 'Sexta à noite', frase: escolherFrase(FRASES_SEXTA, memoria.frases, sortear), duracaoMs: 5 * SEGUNDOS, chave: hoje }
+  }
+
+  if (sortear() >= CHANCE_ALEATORIA) return null
+  const opcoes = COMUNS.filter((c) => c.id !== memoria.ultimoId && !(ctx.movimentoReduzido && c.efeito))
+  const total = opcoes.reduce((s, c) => s + c.peso, 0)
+  let alvo = sortear() * total
+  const c = opcoes.find((o) => (alvo -= o.peso) < 0) ?? opcoes[opcoes.length - 1]
+  if (c.id === 'hora') {
+    const fase = faseDoDia(agora)
+    return { id: 'hora', personagem: fase === 'noite' ? 'lua' : 'sol', frase: escolherFrase(FRASES_HORA[fase], memoria.frases, sortear), duracaoMs: 5 * SEGUNDOS }
+  }
+  return { id: c.id, personagem: c.personagem, titulo: c.titulo, frase: escolherFrase(c.frases, memoria.frases, sortear), duracaoMs: 5500, efeito: c.efeito ?? null }
+}
+
+/** Uma surpresa específica, para testar (?surpresa=id) sem esperar o relógio. */
+export function eventoForcado(id: string, ctx: Contexto, sortear: () => number = Math.random): Evento | null {
+  if (bloqueio(ctx)) return null
+  const unico = eventosUnicos({ ...ctx, memoria: MEMORIA_VAZIA }).find((e) => e.id === id)
+  if (unico) return unico
+  const comum = COMUNS.find((c) => c.id === id)
+  if (comum && comum.id !== 'hora') return { id: comum.id, personagem: comum.personagem, titulo: comum.titulo, frase: escolherFrase(comum.frases, [], sortear), duracaoMs: 5500, efeito: ctx.movimentoReduzido ? null : comum.efeito ?? null }
+  if (id === 'hora') { const fase = faseDoDia(ctx.agora); return { id: 'hora', personagem: fase === 'noite' ? 'lua' : 'sol', frase: escolherFrase(FRASES_HORA[fase], [], sortear), duracaoMs: 5000 } }
+  if (id === 'madrugada') return { id: 'madrugada', personagem: 'lua', titulo: horaFalada(ctx.agora), frase: escolherFrase(FRASES_MADRUGADA, [], sortear), duracaoMs: 5000 }
+  if (id === 'fim-de-semana') return { id: 'fim-de-semana', personagem: 'mascote', frase: fraseFimDeSemana(ctx.agora, horaFalada(ctx.agora), sortear), duracaoMs: 4500 }
+  if (id === 'sexta-noite') return { id: 'sexta-noite', personagem: 'lua', titulo: 'Sexta à noite', frase: escolherFrase(FRASES_SEXTA, [], sortear), duracaoMs: 5000 }
+  return null
+}
+
+/** Memória depois de mostrar a surpresa. */
+export function registrarExibicao(memoria: Memoria, evento: Evento, agora: Date): Memoria {
+  const hoje = chaveLocal(agora)
+  const doDia = memoria.dia[0] === hoje ? memoria.dia[1] : 0
+  const m: Memoria = {
+    ...memoria,
+    ultimoEm: agora.getTime(),
+    ultimoId: evento.id,
+    frases: [...memoria.frases, evento.frase].slice(-12),
+    dia: [hoje, doDia + 1],
+    vistos: evento.chave ? { ...memoria.vistos, [evento.id]: evento.chave } : memoria.vistos,
+  }
+  if (evento.id === 'marco' && memoria.marcoPendente) { m.marcos = [...memoria.marcos, memoria.marcoPendente]; m.marcoPendente = null }
+  if (evento.id === 'mao-de-cirurgiao') m.selos = { ...memoria.selos, 'mao-de-cirurgiao': hoje }
+  const achado = achadoDoEvento(evento.id)
+  return achado ? registrarAchado(m, achado) : m
+}
+
+// ---------- Contas a partir das respostas (respondidas) ----------
+
+interface Tentativa { em: number; correta: boolean | null; confianca?: string }
+interface RegistroMinimo { q?: number; c?: boolean | null; tentativas?: number; confianca?: string; historico?: Tentativa[] }
+
+/** Total de respostas dadas (cada tentativa conta: revisões também são questões respondidas). */
+export function totalRespostas(respondidas: Record<string, RegistroMinimo> | null | undefined): number {
+  let n = 0
+  for (const r of Object.values(respondidas ?? {})) if (r && typeof r === 'object') n += Math.max(1, Number(r.tentativas) || 1)
+  return n
+}
+
+/** Marco cruzado entre dois totais (o maior, se pular mais de um), ou null. */
+export function marcoCruzado(antes: number, depois: number): number | null {
+  let achado: number | null = null
+  for (const m of MARCOS_RESPOSTAS) if (antes < m && depois >= m) achado = m
+  return achado
+}
+
+function tentativas(respondidas: Record<string, RegistroMinimo> | null | undefined): Tentativa[] {
+  const lista: Tentativa[] = []
+  for (const r of Object.values(respondidas ?? {})) {
+    if (!r || typeof r !== 'object') continue
+    if (Array.isArray(r.historico) && r.historico.length) lista.push(...r.historico.filter((h) => h && typeof h.em === 'number'))
+    else if (typeof r.q === 'number') lista.push({ em: r.q, correta: r.c ?? null, confianca: r.confianca })
+  }
+  return lista
+}
+
+/** Respostas de hoje, o melhor dia anterior, as madrugadas da semana e a mão de cirurgião. */
+export function estatisticasDeRespostas(respondidas: Record<string, RegistroMinimo> | null | undefined, agora: Date) {
+  const lista = tentativas(respondidas).filter((t) => t.em <= agora.getTime())
+  const hoje = chaveLocal(agora)
+  const porDia = new Map<string, number>()
+  const noites = new Set<string>()
+  const semana = agora.getTime() - 7 * 86_400_000
+  for (const t of lista) {
+    const d = new Date(t.em)
+    const k = chaveLocal(d)
+    porDia.set(k, (porDia.get(k) ?? 0) + 1)
+    if (t.em >= semana && d.getHours() < 5) noites.add(k)
+  }
+  let melhor = 0
+  for (const [k, n] of porDia) if (k !== hoje && n > melhor) melhor = n
+  const ultimas = lista.sort((a, b) => a.em - b.em).slice(-20)
+  return {
+    respostasHoje: porDia.get(hoje) ?? 0,
+    melhorDiaAnterior: melhor,
+    madrugadasNaSemana: noites.size,
+    maoDeCirurgiao: ultimas.length === 20 && ultimas.every((t) => t.correta === true && (t.confianca ?? 'seguro') === 'seguro'),
+  }
+}
+
+// ---------- Easter eggs acionados pela pessoa ----------
+
+/** Código Konami ortopédico: ↑ ↑ ↓ ↓ ← → ← → O T (de Ortopedia e Traumatologia). */
+export const KONAMI = ['arrowup', 'arrowup', 'arrowdown', 'arrowdown', 'arrowleft', 'arrowright', 'arrowleft', 'arrowright', 'o', 't'] as const
+
+/** Avança o código com a tecla; devolve [nova posição, completou]. */
+export function avancarKonami(posicao: number, tecla: string): [number, boolean] {
+  const t = tecla.toLowerCase()
+  if (t === KONAMI[posicao]) return posicao + 1 === KONAMI.length ? [0, true] : [posicao + 1, false]
+  // ↑ ↑ ↑: quem apertou uma seta a mais continua no começo do código.
+  if (t === 'arrowup') return [posicao === 2 ? 2 : 1, false]
+  return [0, false]
+}
+
+/** Toques repetidos: guarda os instantes e diz se bateu `quantos` dentro da janela. */
+export function contarToques(toques: readonly number[], agora: number, quantos: number, janelaMs: number): [number[], boolean] {
+  const recentes = [...toques.filter((t) => agora - t <= janelaMs), agora]
+  return recentes.length >= quantos ? [[], true] : [recentes, false]
+}
+
+/** Toques na logo que dão o sinal de Tinel. */
+export const TINEL_TOQUES = 5
+export const TINEL_JANELA = 3000
+/** Toques no tipo "Classificação" do flashcard que trazem o martelo de reflexo. */
+export const MARTELO_TOQUES = 3
+export const MARTELO_JANELA = 2000
+/** Toques no gato da Biblioteca até ele ronronar. */
+export const GATO_TOQUES = 3
+
+/** Nomes dos achados (eggs) que o Arquivo do Preceptor lista depois de encontrados. */
+export const ACHADOS: Array<[string, string]> = [
+  ['konami', 'Código ortopédico'],
+  ['tinel', 'Sinal de Tinel na logo'],
+  ['plantao', 'Plantão da madrugada'],
+  ['gato', 'Gato da Biblioteca'],
+  ['martelo', 'Martelo de reflexo'],
+  ['fratura', 'Redução da fratura do link'],
+  ['arquivo', 'Arquivo do Preceptor'],
+  ['console', 'Recado no console'],
+  ['marco', 'Festa das respostas'],
+  ['r1', 'R1 sem dormir'],
+  ['datas', 'Datas especiais'],
+  ['mao', 'Mão de cirurgião'],
+]
+
+/** Achado correspondente ao evento automático (quando houver). */
+export function achadoDoEvento(id: IdEvento): string | null {
+  if (id === 'marco') return 'marco'
+  if (id === 'r1-sem-dormir') return 'r1'
+  if (id === 'mao-de-cirurgiao') return 'mao'
+  if (id === 'madrugada') return 'plantao'
+  return ['dia-ortopedista', 'vespera-teot', 'dia-prova', 'data-especial'].includes(id) ? 'datas' : null
+}
+
+export function registrarAchado(memoria: Memoria, id: string): Memoria {
+  return memoria.achados.includes(id) ? memoria : { ...memoria, achados: [...memoria.achados, id] }
+}
