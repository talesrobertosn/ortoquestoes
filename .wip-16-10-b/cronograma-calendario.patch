+++ b/fixtures/capturar_cronograma_conta.mjs
@@ -0,0 +1,178 @@
+// Capturas do cronograma e da revisão com uma conta de verdade (Supabase falso, como em
+// e2e_sincronia_cronograma.mjs): assinante com cronograma, conta gratuita (vitrine) e os casos
+// de borda (prova amanhã, hoje e passada, plano criado hoje, só um dia de estudo, reta final curta,
+// dia de Teste do cronograma e teste pendente). 1400×860, 390×844 e 844×390, claro e escuro.
+// Uso: SAIDA=/pasta node fixtures/capturar_cronograma_conta.mjs [filtro]
+import { mkdir, readFile } from 'node:fs/promises'
+
+const SUPABASE = 'https://falso.supabase.co'
+process.env.VITE_SUPABASE_URL = SUPABASE
+const { createServer } = await import('vite')
+const { chromium } = await import('playwright')
+const SAIDA = process.env.SAIDA ?? '/tmp/claude-0/capturas-cronograma-conta'
+const filtro = process.argv[2] ?? ''
+await mkdir(SAIDA, { recursive: true })
+const indice = JSON.parse(await readFile('public/acervo/indice.json', 'utf8'))
+const DIA = 86_400_000
+const VERSAO_TERMOS = (await readFile('src/conta/termos.ts', 'utf8')).match(/VERSAO_TERMOS = '([^']+)'/)?.[1] ?? ''
+const CONTA = '11111111-2222-4333-8444-555555555555'
+const iso = (t) => new Date(t - 3 * 3_600_000).toISOString().slice(0, 10) // dia de São Paulo
+const hoje = Date.now()
+
+/** ~600 respostas nas últimas 5 semanas (com revisões feitas e vencendo), como em capturar_cronograma_redesenho.mjs. */
+function historico() {
+  const alvos = indice.questoes.filter((q) => !q.dup && !q.ar && q.an !== 1).filter((_, i) => i % 7 === 0).slice(0, 600)
+  const r = {}
+  alvos.forEach((q, k) => {
+    const diasAtras = 1 + (k % 35)
+    if (diasAtras % 7 === 3) return // um dia perdido por semana
+    const em = hoje - diasAtras * DIA - (k % 50) * 60_000
+    const correta = k % 10 < 7
+    const confianca = k % 9 === 0 ? 'chute' : k % 5 === 0 ? 'duvida' : 'seguro'
+    const h = [{ em, correta, confianca }]
+    let tentativas = 1, acertos = Number(correta), sequencia = correta ? 1 : 0
+    if (k % 3 === 0 && diasAtras > 3) { h.push({ em: em + Math.ceil(diasAtras / 2) * DIA, correta: true, confianca: 'seguro' }); tentativas++; acertos++; sequencia++ }
+    const intervalos = { chute: [1, 3, 7, 14], duvida: [3, 7, 21, 45], seguro: [10, 30, 90, 180] }[confianca]
+    const ultima = h[h.length - 1].em
+    r[q.id] = { c: correta, q: ultima, tentativas, acertos, erros: tentativas - acertos, sequencia, confianca, historico: h, proximaRevisao: !correta ? ultima : ultima + intervalos[Math.min(sequencia, 4) - 1] * DIA }
+  })
+  return r
+}
+const HISTORICO = historico()
+
+// Planos dos cenários: datas relativas a hoje.
+const base = { intensidade: 'firme', folgas: [0], prova: 'TEOT', base_respondidas: 0, incluir_simulados: true }
+const criadoHa = (dias) => new Date(hoje - dias * DIA).toISOString()
+const CENARIOS = {
+  assinante: { premium: true, plano: { ...base, data_prova: iso(hoje + 86 * DIA), criado_em: criadoHa(30), opcoes: { diasLeves: [3], qtdLeve: 15, testes: [{ em: iso(hoje - 15 * DIA), n: 30, certas: 19 }] } } },
+  'teste-hoje': { premium: true, plano: { ...base, data_prova: iso(hoje + 90 * DIA), criado_em: criadoHa(14), opcoes: {} } },
+  'teste-pendente': { premium: true, plano: { ...base, folgas: [], data_prova: iso(hoje + 90 * DIA), criado_em: criadoHa(17), opcoes: { testes: [] } } },
+  'teste-feito': { premium: true, plano: { ...base, folgas: [], data_prova: iso(hoje + 90 * DIA), criado_em: criadoHa(28), opcoes: { testes: [{ em: iso(hoje - 14 * DIA), n: 30, certas: 17 }, { em: iso(hoje), n: 30, certas: 22 }] } } },
+  'prova-amanha': { premium: true, plano: { ...base, data_prova: iso(hoje + DIA), criado_em: criadoHa(20) } },
+  'prova-hoje': { premium: true, plano: { ...base, data_prova: iso(hoje), criado_em: criadoHa(20) } },
+  'prova-passada': { premium: true, plano: { ...base, data_prova: iso(hoje - 5 * DIA), criado_em: criadoHa(40) } },
+  'criado-hoje': { premium: true, plano: { ...base, data_prova: iso(hoje + 8 * DIA), criado_em: criadoHa(0) } },
+  'um-dia': { premium: true, plano: { ...base, folgas: [0, 1, 2, 3, 4, 5, 6].filter((d) => d !== new Date(hoje + 2 * DIA).getDay()), data_prova: iso(hoje + 60 * DIA), criado_em: criadoHa(3) } },
+  'reta-curta': { premium: true, plano: { ...base, data_prova: iso(hoje + 9 * DIA), criado_em: criadoHa(25) } },
+  'reta-final': { premium: true, plano: { ...base, data_prova: iso(hoje + 12 * DIA), criado_em: criadoHa(60) } },
+  gratis: { premium: false, plano: null },
+}
+
+function servidor(cenario) {
+  const c = CENARIOS[cenario]
+  const plano = c.plano ? structuredClone(c.plano) : null
+  const rpcs = {
+    sincronizar_progresso: (a) => [200, (a.alteracoes ?? []).map((e, i) => ({ tipo: e.tipo, item: e.item, valor: e.valor, versao: i + 1, operacao: e.operacao }))],
+    ler_progresso_desde: () => [200, []],
+    obter_acesso_premium: () => [200, [{ premium: c.premium, motivo: c.premium ? 'assinatura' : null, recursos_exclusivos: c.premium, pagamentos_ativos: true }]],
+    obter_estado_conta: () => [200, [{ status_assinatura: c.premium ? 'ativa' : null, cancelar_ao_fim: false, fim_periodo: null }]],
+    obter_plano_estudo: () => [200, plano ? [structuredClone(plano)] : []],
+    ajustar_opcoes_plano: (a) => { if (plano) plano.opcoes = { ...plano.opcoes, ...a.p_patch }; return [200, true] },
+    salvar_plano_estudo: () => [200, null],
+    sinal_aparelho: () => [200, [{ ativo: true, outro_aparelho: null }]],
+    meus_feitos: () => [200, { conquistas: [], dias: {}, indicados_assinantes: 0, indicados_30_dias: 0, simulado_edicoes: [], simulado_participacoes: [], ranking_semana: [], relatos_resolvidos: 0, comentarios_avaliados: 0, contra_corrente: 0, plano: null }],
+  }
+  return async (rota) => {
+    const pedido = rota.request()
+    const url = new URL(pedido.url())
+    const cors = { 'access-control-allow-origin': '*', 'access-control-allow-headers': '*', 'access-control-allow-methods': '*', 'access-control-expose-headers': '*' }
+    if (pedido.method() === 'OPTIONS') return rota.fulfill({ status: 204, headers: cors })
+    const responder = (status, corpo) => rota.fulfill({ status, headers: { ...cors, 'content-type': 'application/json' }, body: JSON.stringify(corpo) })
+    if (url.pathname.startsWith('/auth/v1/user')) return responder(200, usuario())
+    if (url.pathname.startsWith('/auth/v1/')) return responder(200, {})
+    const rpc = url.pathname.match(/^\/rest\/v1\/rpc\/([a-z_]+)$/)?.[1]
+    if (rpc && rpcs[rpc]) { const [s, corpo] = rpcs[rpc](JSON.parse(pedido.postData() || '{}')); return responder(s, corpo) }
+    return responder(200, rpc ? null : [])
+  }
+}
+const usuario = () => ({ id: CONTA, aud: 'authenticated', role: 'authenticated', email: 'tales@exemplo.com', app_metadata: { provider: 'email' }, user_metadata: { nome: 'Tales' }, created_at: '2026-09-01T00:00:00Z' })
+
+const site = await createServer({ server: { port: 5400 + Math.floor(Math.random() * 400), strictPort: false, fs: { strict: false } }, logLevel: 'error' })
+await site.listen()
+const BASE = site.resolvedUrls.local[0]
+const nav = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium', args: ['--no-sandbox'] })
+const erros = []
+
+async function abrir(cenario, largura, altura, esquema, rota) {
+  const celular = largura < 900
+  const ctx = await nav.newContext({ viewport: { width: largura, height: altura }, deviceScaleFactor: celular ? 2 : 1, colorScheme: esquema, locale: 'pt-BR', timezoneId: 'America/Sao_Paulo', isMobile: celular, hasTouch: celular })
+  await ctx.route(`${SUPABASE}/**`, servidor(cenario))
+  const sessao = { access_token: `tok-${CONTA}`, refresh_token: 'r', token_type: 'bearer', expires_in: 3600, expires_at: Math.floor(Date.now() / 1000) + 30 * 24 * 3600, user: usuario() }
+  await ctx.addInitScript(([s, h, t, c, v]) => {
+    sessionStorage.setItem('oq-termos-adiado', v)
+    if (sessionStorage.getItem('semeado')) return
+    sessionStorage.setItem('semeado', '1')
+    localStorage.setItem('sb-ortoquestoes-auth', s)
+    localStorage.setItem('ortoquestoes:tema', JSON.stringify(t))
+    localStorage.setItem('ortoquestoes:consentimento', JSON.stringify({ analytics: false, em: Date.now() }))
+    // As chaves do aparelho da conta (armazenamento por conta).
+    for (const prefixo of ["ortoquestoes:", `ortoquestoes:conta:${c}:`]) {
+      localStorage.setItem(`${prefixo}respondidas`, JSON.stringify(h))
+      localStorage.setItem(`${prefixo}cronograma:tour-v2`, 'true')
+      localStorage.setItem(`${prefixo}cronograma:aviso-simulados`, 'true')
+    }
+  }, [JSON.stringify(sessao), HISTORICO, esquema === 'light' ? 'claro' : 'escuro', CONTA, VERSAO_TERMOS])
+  const p = await ctx.newPage()
+  p.on('pageerror', (e) => erros.push(`${cenario} ${largura}: ${e.message}`))
+  p.on('console', (m) => { if (m.type() === 'error' && !/Failed to load resource|favicon|ERR_/.test(m.text())) erros.push(`${cenario} ${largura}: ${m.text()}`) })
+  await p.goto(BASE + rota)
+  return p
+}
+async function semRolagemLateral(p, nome) {
+  const l = await p.evaluate(() => ({ doc: document.documentElement.scrollWidth, vw: innerWidth }))
+  if (l.doc > l.vw + 1) erros.push(`${nome}: rolagem horizontal ${JSON.stringify(l)}`)
+}
+async function recusar(p) { await p.evaluate(() => [...document.querySelectorAll('button')].find((b) => b.textContent?.trim() === 'Recusar')?.click()).catch(() => {}) }
+
+const TAMANHOS = [['computador', 1400, 860], ['celular', 390, 844], ['deitado', 844, 390]]
+for (const [cenario] of Object.entries(CENARIOS)) {
+  if (filtro && !cenario.startsWith(filtro) && filtro !== 'revisao') continue
+  if (filtro === 'revisao') break
+  const principais = cenario === 'assinante' || cenario === 'gratis'
+  for (const [nome, l, a] of principais ? TAMANHOS : TAMANHOS.slice(0, 2)) {
+    for (const esquema of principais && nome !== 'deitado' ? ['light', 'dark'] : ['light']) {
+      const id = `${cenario}-${nome}-${esquema === 'light' ? 'claro' : 'escuro'}`
+      const p = await abrir(cenario, l, a, esquema, '#/cronograma')
+      try { await p.waitForSelector('.cp-onde', { timeout: 30000 }) } catch { erros.push(`${id}: o cronograma não abriu`); await p.screenshot({ path: `${SAIDA}/${id}-erro.png` }); await p.context().close(); continue }
+      await recusar(p)
+      await p.waitForTimeout(900)
+      await p.screenshot({ path: `${SAIDA}/${id}-tela.png` })
+      await p.screenshot({ path: `${SAIDA}/${id}-inteira.png`, fullPage: true })
+      await semRolagemLateral(p, id)
+      const cal = p.locator('.cc-embutido')
+      if (await cal.count()) {
+        await cal.scrollIntoViewIfNeeded()
+        await p.waitForTimeout(300)
+        await p.screenshot({ path: `${SAIDA}/${id}-calendario.png` })
+        const teste = p.locator('.cc-embutido .cc-dia--marco > button').first()
+        if (await teste.count()) { await teste.click(); await p.waitForTimeout(400); await p.screenshot({ path: `${SAIDA}/${id}-calendario-teste.png` }) }
+      }
+      const cartao = p.locator('.cp-teste')
+      if (await cartao.count()) { await cartao.scrollIntoViewIfNeeded(); await p.waitForTimeout(200); await cartao.screenshot({ path: `${SAIDA}/${id}-teste.png` }) }
+      await p.context().close()
+    }
+  }
+}
+// Revisão.
+if (!filtro || filtro === 'revisao') {
+  for (const [nome, l, a] of TAMANHOS) {
+    for (const esquema of nome === 'deitado' ? ['light'] : ['light', 'dark']) {
+      const id = `revisao-${nome}-${esquema === 'light' ? 'claro' : 'escuro'}`
+      const p = await abrir('assinante', l, a, esquema, '#/revisao')
+      try { await p.waitForSelector('.rvx', { timeout: 30000 }) } catch { erros.push(`${id}: a revisão não abriu`); await p.screenshot({ path: `${SAIDA}/${id}-erro.png` }); await p.context().close(); continue }
+      await recusar(p)
+      await p.waitForTimeout(800)
+      await p.screenshot({ path: `${SAIDA}/${id}-inteira.png`, fullPage: true })
+      const cal = p.locator('.rvx-calendario')
+      await cal.scrollIntoViewIfNeeded()
+      const futuro = p.locator('.rvx-calendario .cc-dia--futuro > button').nth(3)
+      if (await futuro.count()) { await futuro.click(); await p.waitForTimeout(400) }
+      await cal.screenshot({ path: `${SAIDA}/${id}-calendario.png` })
+      await semRolagemLateral(p, id)
+      await p.context().close()
+    }
+  }
+}
+await nav.close()
+await site.close()
+console.log(erros.length ? erros.join('\n') : 'sem erros')
