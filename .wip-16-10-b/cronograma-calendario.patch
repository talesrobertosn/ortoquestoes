+// Capturas do redesenho do cronograma e da revisão (16/10/2026): antes e depois, nos três tamanhos
+// (1400×860, 1280×720 e 390×844), claro e escuro, para o assinante (modo demonstração, plano realista),
+// para a conta grátis (vitrine) e para a página de Revisão (com um histórico de exemplo).
+// Uso: npx vite --port 5193 (em outro terminal) e depois
+//   ROTULO=depois node fixtures/capturar_cronograma_redesenho.mjs [filtro]
+// BASE=http://localhost:5193/ e SAIDA=/tmp/claude-0/capturas-cronograma2 por padrão.
+import { chromium } from 'playwright'
+import { mkdir, readFile } from 'node:fs/promises'
+
+const SAIDA = process.env.SAIDA ?? '/tmp/claude-0/capturas-cronograma2'
+const ROTULO = process.env.ROTULO ?? 'depois'
+const BASE = process.env.BASE ?? 'http://localhost:5193/'
+const filtro = process.argv[2] ?? ''
+await mkdir(SAIDA, { recursive: true })
+const indice = JSON.parse(await readFile('public/acervo/indice.json', 'utf8'))
+
+/** Um histórico de exemplo: ~600 respostas nas últimas 5 semanas, com revisões feitas e vencendo. */
+function historicoExemplo() {
+  const DIA = 86_400_000
+  const agora = Date.now()
+  const alvos = indice.questoes.filter((q) => !q.dup && !q.ar && q.an !== 1).filter((_, i) => i % 7 === 0).slice(0, 600)
+  const r = {}
+  alvos.forEach((q, k) => {
+    const diasAtras = 1 + (k % 35)
+    const em = agora - diasAtras * DIA - (k % 50) * 60_000
+    const correta = k % 10 < 7
+    const confianca = k % 9 === 0 ? 'chute' : k % 5 === 0 ? 'duvida' : 'seguro'
+    const historico = [{ em, correta, confianca }]
+    let tentativas = 1, acertos = Number(correta), sequencia = correta ? 1 : 0
+    // Algumas já foram revisadas (dias passados com revisões feitas).
+    if (k % 3 === 0 && diasAtras > 3) { const em2 = em + Math.ceil(diasAtras / 2) * DIA; historico.push({ em: em2, correta: true, confianca: 'seguro' }); tentativas++; acertos++; sequencia++ }
+    const intervalos = { chute: [1, 3, 7, 14], duvida: [3, 7, 21, 45], seguro: [10, 30, 90, 180] }[confianca]
+    const ultima = historico[historico.length - 1].em
+    const proximaRevisao = !correta ? ultima : ultima + intervalos[Math.min(sequencia, 4) - 1] * DIA
+    r[q.id] = { c: correta, q: ultima, tentativas, acertos, erros: tentativas - acertos, sequencia, confianca, historico, proximaRevisao }
+  })
+  return r
+}
+const HISTORICO = historicoExemplo()
+
+const nav = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium', args: ['--no-sandbox'] })
+const erros = []
+async function pagina(largura, altura, esquema, comHistorico) {
+  const celular = largura < 500
+  const ctx = await nav.newContext({ viewport: { width: largura, height: altura }, deviceScaleFactor: celular ? 2 : 1, colorScheme: esquema, locale: 'pt-BR', timezoneId: 'America/Sao_Paulo', isMobile: celular, hasTouch: celular })
+  await ctx.addInitScript(([t, h]) => {
+    localStorage.setItem('ortoquestoes:tema', JSON.stringify(t))
+    localStorage.setItem('ortoquestoes:cronograma:tour-v2', 'true')
+    localStorage.setItem('ortoquestoes:consentimento', JSON.stringify({ analytics: false, em: Date.now() }))
+  }, [esquema === 'light' ? 'claro' : 'escuro', comHistorico ? HISTORICO : null])
+  const p = await ctx.newPage()
+  p.comHistorico = comHistorico
+  p.on('pageerror', (e) => erros.push(`${largura}: ${e}`))
+  p.on('console', (m) => { if (m.type() === 'error' && !/Failed to load resource|favicon/.test(m.text())) erros.push(`${largura}: ${m.text()}`) })
+  return p
+}
+/**
+ * Sem conta (o Vite desta captura roda sem Supabase), o visitante não lê o localStorage: o histórico de
+ * exemplo e o tour visto entram depois de a página carregar.
+ */
+async function semear(p, comHistorico) {
+  // Visitante guarda tudo só na memória da aba: grava pelo próprio módulo do site (o Vite serve o mesmo).
+  await p.evaluate(async (h) => {
+    const m = await import('/src/estado/armazenamento.ts')
+    m.gravar('cronograma:tour-v2', true)
+    if (h) m.gravar('respondidas', h)
+  }, comHistorico ? HISTORICO : null)
+  await p.waitForTimeout(300)
+}
+async function recusarCookies(p) { await p.evaluate(() => [...document.querySelectorAll('button')].find((b) => b.textContent?.trim() === 'Recusar')?.click()).catch(() => {}) }
+async function semRolagemLateral(p, nome) {
+  const l = await p.evaluate(() => ({ doc: document.documentElement.scrollWidth, vw: innerWidth }))
+  if (l.doc > l.vw + 1) erros.push(`${nome}: rolagem horizontal ${JSON.stringify(l)}`)
+}
+
+const TAMANHOS = [['computador', 1400, 860], ['notebook', 1280, 720], ['celular', 390, 844]]
+for (const [nome, l, a] of TAMANHOS) {
+  for (const esquema of ['light', 'dark']) {
+    const tema = esquema === 'light' ? 'claro' : 'escuro'
+    const id = `${nome}-${tema}`
+    // 1. Assinante (modo demonstração: plano até o TEOT com estudo nos últimos dias).
+    if (!filtro || filtro.startsWith('assinante') || filtro === id) {
+      const p = await pagina(l, a, esquema, false)
+      await p.goto(`${BASE}#/cronograma?demo=1`)
+      await p.waitForSelector('.cp-hoje', { timeout: 30000 })
+      await semear(p, p.comHistorico)
+      await recusarCookies(p)
+      await p.waitForTimeout(700)
+      await p.screenshot({ path: `${SAIDA}/${ROTULO}-assinante-${id}-tela.png` })
+      await p.screenshot({ path: `${SAIDA}/${ROTULO}-assinante-${id}-inteira.png`, fullPage: true })
+      await semRolagemLateral(p, `assinante ${id}`)
+      // O calendário embutido (depois do redesenho): um dia futuro aberto.
+      const embutido = p.locator('.cc-embutido')
+      if (await embutido.count()) {
+        await embutido.scrollIntoViewIfNeeded()
+        const futuro = p.locator('.cc-embutido .cc-dia--futuro > button').nth(2)
+        if (await futuro.count()) { await futuro.click(); await p.waitForTimeout(450) }
+        await p.locator('.cc-embutido').screenshot({ path: `${SAIDA}/${ROTULO}-assinante-${id}-calendario.png` })
+        await semRolagemLateral(p, `calendário ${id}`)
+        const expandir = p.locator('.cc-embutido .cc-expandir')
+        if (await expandir.count()) {
+          await expandir.click(); await p.waitForSelector('.cc-janela'); await p.waitForTimeout(450)
+          await p.screenshot({ path: `${SAIDA}/${ROTULO}-assinante-${id}-calendario-cheio.png` })
+          await p.keyboard.press('Escape'); await p.waitForTimeout(250)
+          if (await p.locator('.cc-janela').count()) erros.push(`${id}: Esc não fechou o calendário cheio`)
+        }
+      }
+      await p.context().close()
+    }
+    // 2. Assinante com a meta de hoje feita (o adiantar vira destaque).
+    if ((!filtro || filtro.startsWith('feita') || filtro === id) && esquema === 'light') {
+      const p = await pagina(l, a, esquema, false)
+      await p.goto(`${BASE}#/cronograma?demo=1&feita`)
+      await p.waitForSelector('.cp-hoje', { timeout: 30000 })
+      await semear(p, p.comHistorico)
+      await recusarCookies(p)
+      await p.waitForTimeout(600)
+      await p.screenshot({ path: `${SAIDA}/${ROTULO}-feita-${id}-tela.png` })
+      await p.context().close()
+    }
+    // 3. Conta grátis: a vitrine.
+    if (!filtro || filtro.startsWith('gratis') || filtro === id) {
+      const p = await pagina(l, a, esquema, true)
+      await p.goto(`${BASE}#/cronograma`)
+      await p.waitForSelector('.cp-hoje', { timeout: 30000 })
+      await semear(p, p.comHistorico)
+      await recusarCookies(p)
+      await p.waitForTimeout(600)
+      await p.screenshot({ path: `${SAIDA}/${ROTULO}-gratis-${id}-tela.png` })
+      await p.screenshot({ path: `${SAIDA}/${ROTULO}-gratis-${id}-inteira.png`, fullPage: true })
+      await semRolagemLateral(p, `grátis ${id}`)
+      await p.context().close()
+    }
+    // 4. Revisão.
+    if (!filtro || filtro.startsWith('revisao') || filtro === id) {
+      const p = await pagina(l, a, esquema, true)
+      await p.goto(`${BASE}#/revisao`)
+      await p.waitForSelector('.rvx', { timeout: 30000 })
+      await semear(p, true)
+      await recusarCookies(p)
+      await p.waitForTimeout(700)
+      await p.screenshot({ path: `${SAIDA}/${ROTULO}-revisao-${id}-tela.png` })
+      await p.screenshot({ path: `${SAIDA}/${ROTULO}-revisao-${id}-inteira.png`, fullPage: true })
+      const cal = p.locator('.rvx-calendario, .rc-calendario').first()
+      if (await cal.count()) {
+        await cal.scrollIntoViewIfNeeded()
+        const futuro = p.locator('.rc-calendario .cc-dia--futuro > button').nth(3)
+        if (await futuro.count()) { await futuro.click(); await p.waitForTimeout(450) }
+        await cal.screenshot({ path: `${SAIDA}/${ROTULO}-revisao-${id}-calendario.png` })
+      }
+      await semRolagemLateral(p, `revisão ${id}`)
+      await p.context().close()
+    }
+  }
+}
+await nav.close()
+console.log(erros.length ? erros.join('\n') : 'sem erros')
