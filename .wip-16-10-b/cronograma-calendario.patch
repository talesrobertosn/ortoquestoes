+// Teste do cronograma (16/10/2026): a agenda (quinzenal, semanal nas 4 semanas antes da reta final,
+// o teste da revisão forte, folga, dia leve e semana difícil), o teste pendente por até 7 dias,
+// a divisão das vagas por incidência e o registro do resultado no JSON `opcoes` do plano.
+// Roda de novo em 4 fusos do aparelho (TZ) para conferir a virada do dia de São Paulo.
+import assert from 'node:assert/strict'
+import { build } from 'esbuild'
+import { execFileSync } from 'node:child_process'
+import { mkdtemp, readFile, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { fileURLToPath, pathToFileURL } from 'node:url'
+
+const pasta = await mkdtemp(join(tmpdir(), 'oq-'))
+const arquivo = join(pasta, 'm.mjs')
+try {
+  await build({
+    stdin: { contents: `export * from './src/dados/planoEstudo'; export { cotasPorIncidencia, idsMiniSimulado } from './src/dados/hubCronograma'; export { opcoesComTeste } from './src/conta/cronograma'; export { pesoIncidenciaDoTema } from './src/dados/incidencia'`, resolveDir: process.cwd() },
+    outfile: arquivo, bundle: true, platform: 'node', format: 'esm',
+    define: { 'import.meta.env': JSON.stringify({ BASE_URL: '/', DEV: false, VITE_SUPABASE_URL: '' }) }, logLevel: 'error',
+  })
+  const m = await import(pathToFileURL(arquivo))
+  const indice = JSON.parse(await readFile('public/acervo/indice.json', 'utf8'))
+  const iso = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
+  const data = (s) => { const [a, b, c] = s.split('-').map(Number); return new Date(a, b - 1, c) }
+  const plano = (extra = {}) => ({ data_prova: '2027-01-10', intensidade: 'firme', folgas: [0], prova: 'TEOT', base_respondidas: 0, criado_em: '2026-10-14T12:00:00Z', incluir_simulados: true, ...extra })
+
+  if (process.env.TZ_FILHO) {
+    // Fuso: às 23h10 de 27/10 em São Paulo ainda não é dia de teste; às 0h10 de 28/10 já é,
+    // seja qual for o fuso do aparelho.
+    const instante = Date.UTC(2026, 9, 28, 2, 10)
+    assert.equal(m.calcularPlano(indice, {}, plano(), instante).testes.hoje, false, `TZ=${process.env.TZ}: 23h10 de São Paulo ainda não é o dia do teste`)
+    assert.equal(m.calcularPlano(indice, {}, plano(), instante + 3_600_000).testes.hoje, true, `TZ=${process.env.TZ}: 0h10 de São Paulo já é o dia do teste`)
+    //    Pendente: 7 dias depois ainda vale; 8 dias depois, não (mesmo com horário de verão no aparelho).
+    assert.ok(m.calcularPlano(indice, {}, plano(), Date.UTC(2026, 10, 4, 15)).testes.pendente, `TZ=${process.env.TZ}: pendente no 7º dia`)
+    assert.equal(m.calcularPlano(indice, {}, plano(), Date.UTC(2026, 10, 5, 15)).testes.pendente, null, `TZ=${process.env.TZ}: pendente no 8º dia`)
+    process.exit(0)
+  }
+
+  const agenda = (criado, reta, tipoDe) => [...m.agendaTestes(data(criado), data(reta), tipoDe)].sort((a, b) => a - b).map((t) => iso(new Date(t)))
+  const semanal = (folgas = [], leves = [], dificeis = []) => (d) => folgas.includes(d.getDay()) ? 'folga'
+    : dificeis.some((s) => d >= data(s) && d < new Date(data(s).getFullYear(), data(s).getMonth(), data(s).getDate() + 7)) ? 'dificil'
+    : leves.includes(d.getDay()) ? 'leve' : 'estudo'
+
+  assert.equal(m.NOME_TESTE, 'Teste do cronograma')
+
+  // 1. Quinzenal desde a criação e semanal nas 4 semanas antes da reta final (domingo de folga).
+  //    Criado na quarta 14/10/2026, prova 10/01/2027: reta final em 27/12, semanais a partir de 29/11.
+  const a1 = agenda('2026-10-14', '2026-12-27', semanal([0]))
+  assert.deepEqual(a1, ['2026-10-28', '2026-11-11', '2026-11-30', '2026-12-07', '2026-12-14', '2026-12-21'], `agenda: ${a1}`)
+  for (let i = 1; i < a1.length; i++) assert.ok(Math.round((data(a1[i]) - data(a1[i - 1])) / 864e5) >= 7, 'testes colados')
+  assert.ok(a1.every((d) => data(d) < data('2026-12-27') && data(d).getDay() !== 0), 'teste na reta final ou na folga')
+
+  // 2. Dia leve: o teste da quarta passa para a quinta. Semana difícil: sai da semana dela.
+  assert.equal(agenda('2026-10-14', '2026-12-27', semanal([0], [3]))[0], '2026-10-29', 'dia leve deveria empurrar o teste para o dia normal seguinte')
+  const a3 = agenda('2026-10-14', '2026-12-27', semanal([0], [], ['2026-11-09']))
+  assert.ok(!a3.some((d) => d >= '2026-11-09' && d <= '2026-11-15'), `teste na semana difícil: ${a3}`)
+  assert.ok(a3.includes('2026-11-16'), 'o teste da semana difícil deveria ir para a segunda seguinte')
+
+  // 3. Só dias leves (nenhum dia normal): o teste não some, cai no primeiro dia que não é folga.
+  const a4 = agenda('2026-10-14', '2026-12-27', semanal([0], [1, 2, 3, 4, 5, 6]))
+  assert.equal(a4.length, a1.length, 'semana só de dias leves perdeu testes')
+  assert.ok(a4.every((d) => data(d).getDay() !== 0))
+  //    Todos os dias de folga menos a segunda: todos os testes caem às segundas.
+  const a5 = agenda('2026-10-14', '2026-12-27', semanal([0, 2, 3, 4, 5, 6]))
+  assert.ok(a5.length >= 5 && a5.every((d) => data(d).getDay() === 1), `todos de folga menos segunda: ${a5}`)
+  //    Sete dias de folga (o formulário não deixa): nenhum teste, sem travar.
+  assert.deepEqual(agenda('2026-10-14', '2026-12-27', () => 'folga'), [])
+
+  // 4. Plano curto: nenhum teste na primeira semana do plano; reta final amanhã, nenhum teste.
+  const a6 = agenda('2026-10-14', '2026-11-08', semanal([0]))
+  assert.ok(a6.length >= 1 && a6.length <= 3, `plano curto: ${a6}`)
+  assert.ok(a6.every((d) => Math.round((data(d) - data('2026-10-14')) / 864e5) >= 7), `teste na primeira semana do plano: ${a6}`)
+  assert.deepEqual(agenda('2026-10-14', '2026-10-15', semanal([0])), [])
+
+  // 5. No plano: datas, o teste da revisão forte e o pendente por até 7 dias.
+  const em = (a, mes, dia) => new Date(a, mes - 1, dia, 10)
+  const c0 = m.calcularPlano(indice, {}, plano(), em(2026, 10, 16))
+  assert.deepEqual(c0.testes.datas.map(iso), [...a1, '2026-12-28'], 'o teste da revisão forte é o primeiro dia de estudo dela (27/12 é domingo)')
+  assert.equal(c0.testes.hoje, false); assert.equal(c0.testes.pendente, null); assert.equal(iso(c0.testes.proximo), '2026-10-28')
+  assert.equal(c0.dias.filter((d) => d.mini).map((d) => iso(d.data)).join(), a1.join(), 'os dias do motor marcados como teste')
+  const noDia = m.calcularPlano(indice, {}, plano(), em(2026, 10, 28))
+  assert.equal(noDia.testes.hoje, true); assert.equal(noDia.miniHoje, true)
+  const comOpcoes = (quando, opcoes) => m.calcularPlano(indice, {}, plano({ opcoes }), quando)
+  assert.equal(iso(comOpcoes(em(2026, 10, 30)).testes.pendente), '2026-10-28', 'teste perdido deveria ficar pendente')
+  assert.equal(iso(comOpcoes(em(2026, 11, 4)).testes.pendente), '2026-10-28', 'pendente ainda no 7º dia')
+  assert.equal(comOpcoes(em(2026, 11, 5)).testes.pendente, null, 'pendente passou de 7 dias')
+  assert.equal(comOpcoes(em(2026, 10, 30), { testes: [{ em: '2026-10-29', n: 30, certas: 20 }] }).testes.pendente, null, 'teste feito depois da data não está mais pendente')
+  const feito = comOpcoes(em(2026, 10, 28), { testes: [{ em: '2026-10-28', n: 30, certas: 20 }] })
+  assert.equal(feito.testes.feitoHoje, true); assert.equal(feito.testes.feitos.length, 1)
+  const reta = m.calcularPlano(indice, {}, plano(), em(2026, 12, 28))
+  assert.equal(reta.naRetaFinal, true); assert.equal(reta.testes.hoje, true, 'dia do teste da revisão forte')
+  //    Reta final curta (plano de 30 dias): sem revisão forte, sem teste nela.
+  const curto = m.calcularPlano(indice, {}, plano({ data_prova: '2026-11-13' }), em(2026, 10, 16))
+  assert.equal(curto.diasRetaFinal, 7)
+  assert.ok(curto.testes.datas.every((d) => d < curto.inicioRetaFinal), 'teste dentro da reta final curta')
+  //    Dia de teste num dia leve (só dias leves): o teste aparece e a meta é a do dia leve.
+  const leve = comOpcoes(em(2026, 10, 28), { diasLeves: [1, 2, 3, 4, 5, 6], qtdLeve: 15 })
+  assert.equal(leve.testes.hoje, true); assert.equal(leve.metaDiaria, 15)
+
+  // 6. Cotas por incidência: soma n, respeita o que cada área tem, a sobra vai para as outras.
+  const areas = [...new Set(indice.temas.map((t) => t.slug))].filter((s) => m.pesoIncidenciaDoTema(s) > 0).slice(0, 5)
+  assert.ok(areas.length >= 3, 'áreas com incidência faltando no índice')
+  const lista = (s, k) => Array.from({ length: k }, (_, i) => `${s}-${i}`)
+  const peso = (s) => m.pesoIncidenciaDoTema(s)
+  const grande = new Map(areas.map((s) => [s, lista(s, 50)]))
+  const cot = m.cotasPorIncidencia(grande, 30)
+  assert.equal(cot.length, 30); assert.equal(new Set(cot).size, 30)
+  const conta = (ids, s) => ids.filter((id) => id.startsWith(`${s}-`)).length
+  const soma = areas.reduce((x, a) => x + peso(a), 0)
+  for (const s of areas) assert.ok(Math.abs(conta(cot, s) - (30 * peso(s)) / soma) < 1, `${s}: ${conta(cot, s)} vagas, ideal ${((30 * peso(s)) / soma).toFixed(2)}`)
+  const ordem = [...areas].sort((a, b) => peso(b) - peso(a))
+  const pouca = new Map(grande); pouca.set(ordem[0], lista(ordem[0], 2))
+  const cot2 = m.cotasPorIncidencia(pouca, 30)
