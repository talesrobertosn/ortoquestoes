+/**
+ * As datas dos testes do cronograma (meia-noite local, em ms), da criação até a reta final:
+ * a cada INTERVALO_MINI dias desde a criação enquanto faltam mais de SEMANAS_TESTE_SEMANAL
+ * semanas para a reta final; depois, um por semana, contado para trás a partir dela. Cada
+ * marco cai no primeiro dia de estudo normal (sem folga, dia leve ou semana difícil) da semana dele;
+ * se a semana não tiver nenhum, no primeiro dia que não é folga.
+ */
+export function agendaTestes(criado: Date, inicioRetaFinal: Date, tipoDe: (d: Date) => TipoDia): Set<number> {
+  const datas = new Set<number>()
+  const somar = (d: Date, n: number) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n)
+  // O primeiro dia de estudo normal da semana do marco; numa semana sem nenhum (só dias leves,
+  // semana difícil), o primeiro dia que não é folga: o teste não some por causa da rotina.
+  const primeiroNormal = (alvo: Date) => {
+    let reserva: Date | null = null
+    for (let k = 0; k < 7; k++) {
+      const x = somar(alvo, k)
+      if (x >= inicioRetaFinal) break
+      const tipo = tipoDe(x)
+      if (tipo === 'estudo') return x
+      if (tipo !== 'folga' && !reserva) reserva = x
+    }
+    return reserva
+  }
+  const inicioSemanal = somar(inicioRetaFinal, -SEMANAS_TESTE_SEMANAL * INTERVALO_MINI_FINAL)
+  for (let marco = INTERVALO_MINI; marco < 800; marco += INTERVALO_MINI) {
+    const alvo = somar(criado, marco)
+    // Um teste quinzenal colado no primeiro semanal (menos de uma semana antes) sai.
+    if (diasEntre(alvo, inicioSemanal) < INTERVALO_MINI_FINAL) break
+    const x = primeiroNormal(alvo)
+    if (x) datas.add(x.getTime())
+  }
+  for (let k = SEMANAS_TESTE_SEMANAL; k >= 1; k--) {
+    const alvo = somar(inicioRetaFinal, -k * INTERVALO_MINI_FINAL)
+    if (diasEntre(criado, alvo) < INTERVALO_MINI_FINAL) continue
+    const x = primeiroNormal(alvo)
+    if (x) datas.add(x.getTime())
+  }
+  return datas
+}
