# Variáveis públicas do build. A chave anon é pública por definição; a segurança vem de RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Chave geral do cliente. Deve permanecer false até o roteiro de ativação ser concluído.
VITE_LIMITES_HABILITADOS=false
VITE_PAGAMENTOS_HABILITADOS=false

# Nunca coloque abaixo em .env do Vite. Configure com `supabase secrets set`:
# SUPABASE_SERVICE_ROLE_KEY=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# APP_ORIGIN=https://ortoquestoes.com.br
# PAGAMENTOS_HABILITADOS=false
# MERCADO_PAGO_INTEGRACAO_VALIDADA=false
