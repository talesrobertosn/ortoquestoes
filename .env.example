# Copie para .env.local. Apenas valores públicos; nunca use secret/service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública atual do Supabase. Nunca use service_role ou secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA
# Fallback temporário para projetos que ainda usam a chave anon pública.
VITE_SUPABASE_ANON_KEY=
VITE_LIMITES_HABILITADOS=false
VITE_PAGAMENTOS_HABILITADOS=false

# Configuradas exclusivamente nas Edge Functions; deixe os valores vazios neste arquivo público.
# SUPABASE_SERVICE_ROLE_KEY=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_AMBIENTE=teste
# MERCADO_PAGO_PAYER_EMAIL_TESTE=
# MERCADO_PAGO_WEBHOOK_SECRET=
# Os planos sem associação são definidos no servidor por preço e periodicidade; não há IDs de plano no cliente.
# APP_ORIGIN=https://ortoquestoes.com.br
# PAGAMENTOS_HABILITADOS=false
# MERCADO_PAGO_INTEGRACAO_VALIDADA=false
