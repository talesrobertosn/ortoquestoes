+  .cc-detalhe { position: static; }
+}
+@media (max-width: 40rem) {
+  .cc-semana, .cc-grade { gap: 4px; }
+  .cc-semana li { padding: 0; text-align: center; font-size: 0.62rem; letter-spacing: 0.04em; }
