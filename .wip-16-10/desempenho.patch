+.cc-topo { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.6rem 1rem; padding: 1rem 1.25rem 0.9rem; background: var(--superficie); border-bottom: 1px solid var(--traco); }
